# Bullet Physics FFI Bindings — Rigid Body Dynamics
# Target: BulletCollision.dll, BulletDynamics.dll, LinearMath.dll

library "BulletDynamics" {
  fn btDefaultCollisionConfiguration_new() -> ptr;
  fn btCollisionDispatcher_new(config: ptr) -> ptr;
  fn btDbvtBroadphase_new() -> ptr;
  fn btSequentialImpulseConstraintSolver_new() -> ptr;
  fn btDiscreteDynamicsWorld_new(dispatcher: ptr, broadphase: ptr, solver: ptr, config: ptr) -> ptr;
  fn btDiscreteDynamicsWorld_stepSimulation(world: ptr, time_step: f32, max_sub_steps: i32, fixed_time_step: f32) -> i32;
  fn btDiscreteDynamicsWorld_addRigidBody(world: ptr, body: ptr);
  fn btDiscreteDynamicsWorld_removeRigidBody(world: ptr, body: ptr);
  fn btDiscreteDynamicsWorld_setGravity(world: ptr, x: f32, y: f32, z: f32);
}

library "BulletCollision" {
  fn btBoxShape_new(half_x: f32, half_y: f32, half_z: f32) -> ptr;
  fn btSphereShape_new(radius: f32) -> ptr;
  fn btCapsuleShape_new(radius: f32, height: f32) -> ptr;
  fn btStaticPlaneShape_new(normal_x: f32, normal_y: f32, normal_z: f32, constant: f32) -> ptr;
  fn btConvexHullShape_new(points: ptr, num_points: i32, stride: i32) -> ptr;
}

library "BulletDynamics_btRigidBody" {
  fn btRigidBody_new(mass: f32, motion_state: ptr, collision_shape: ptr, local_inertia: ptr) -> ptr;
  fn btRigidBody_getWorldTransform(body: ptr, transform: ptr);
  fn btRigidBody_setWorldTransform(body: ptr, transform: ptr);
  fn btRigidBody_setLinearVelocity(body: ptr, x: f32, y: f32, z: f32);
  fn btRigidBody_setAngularVelocity(body: ptr, x: f32, y: f32, z: f32);
  fn btRigidBody_applyCentralForce(body: ptr, x: f32, y: f32, z: f32);
  fn btRigidBody_applyCentralImpulse(body: ptr, x: f32, y: f32, z: f32);
  fn btRigidBody_setRestitution(body: ptr, value: f32);
  fn btRigidBody_setFriction(body: ptr, value: f32);
  fn btRigidBody_setDamping(body: ptr, linear: f32, angular: f32);
}
