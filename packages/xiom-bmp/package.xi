  keywords: ["bmp", "image", "pixels", "format"];
  license: "MIT OR Apache-2.0";
  repository: "https://github.com/xiom-packages/packages";
  authors: ["Eleftherios Notas", "The XIOM Authors"];
  modules: ["xiom.bmp"];
  deps: { "xiom.std": ">=0.60.0 <1.0.0" };
}
