package xiom_graphql {
  name: "xiom.graphql";
  version: "0.1.0";
  description: "Schema-first GraphQL server -- SDL loading, validation, execution, resolvers, subscriptions, built on xiom.http";
  authors: ["XIOM Team"];
  deps: { "xiom.std": "0.1.0", "xiom.http": "0.1.0", "xiom.json": "0.1.0", "xiom.websocket": "0.1.0" };
}
