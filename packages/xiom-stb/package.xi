package xiom_stb {
  name: "xiom.stb";
  version: "0.2.0";
  description: "stb image codecs for XIOM (vendored stb_image + stb_image_write single headers; in-memory PNG encode/decode + BMP decode probe)";
  categories: ["graphics", "media"];
  keywords: ["stb", "stb-image", "textures", "png", "image", "binding"];
  license: "MIT OR Apache-2.0";
  repository: "https://github.com/xiom-packages/packages";
  authors: ["XIOM Team"];
  deps: { "xiom.std": ">=0.60.0 <1.0.0" };
}
