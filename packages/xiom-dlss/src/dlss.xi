// =========================================================================
// Library: module handles + resolved entry table
// =========================================================================

/// One loaded module (path + handle; handle 0 = not present).
pub type DlssModuleFound = {
  path: Str;
  handle: Int;
}

/// A resolved NGX runtime: the opened module handles plus per-entry
/// resolution results.  `names[i]` is the export name that resolved
/// ("" = unresolved), `addrs[i]` its address (0 = unresolved); both are
/// indexed like `surface.dlss_table_entries()`.
pub type DlssLibrary = {
  h_dlss: Int;
  n_dlss: Str;
  h_core: Int;
  n_core: Str;
  h_fg: Int;
  n_fg: Str;
  h_rr: Int;
  n_rr: Str;
  count: Int;
  names: Vec[Str];
  addrs: Vec[Int];
}

fn open_quiet(path: Str) -> Int
  requires: path.len() > 0
{
  let r = dl.dl_open(path);
  if r.is_ok { return r.value; }
  return 0;
}

fn module_dirs() -> Vec[Str]
  requires: true
{
  var dirs: Vec[Str] = Vec[Str].new();
  dirs.push("");  // bare name: OS search order (exe dir, System32, PATH)
  dirs.push(".");
  let sr = io.env_var("SystemRoot");
  if sr.is_some {
    dirs.push(io.join_paths(sr.value, "System32"));
  }
  return dirs;
}

fn dirs_desc(dirs: &Vec[Str]) -> Str
  requires: true
{
  var s = "";
  var i = 0;
  while i < dirs.len() {
    if i > 0 { s = s + ", "; }
    if dirs[i].len() == 0 {
      s = s + "(loader search)";
    } else {
      s = s + dirs[i];
    }
    i = i + 1;
  }
  return s;
}

fn find_module(name: Str, dirs: &Vec[Str]) -> DlssModuleFound
  requires: name.len() > 0
{
  var i = 0;
  while i < dirs.len() {
    let d = dirs[i];
    var path = name;
    if d.len() > 0 {
      path = io.join_paths(d, name);
    }
    if d.len() == 0 || io.file_exists(path) {
      let h = open_quiet(path);
      if h != 0 {
        return DlssModuleFound{ path: path; handle: h; };
      }
    }
    i = i + 1;
  }
  return DlssModuleFound{ path: ""; handle: 0; };
}

fn explicit_module(path: Str) -> DlssModuleFound
  requires: true
{
  if path.len() == 0 {
    return DlssModuleFound{ path: ""; handle: 0; };
  }
  let h = open_quiet(path);
  if h != 0 {
    return DlssModuleFound{ path: path; handle: h; };
  }
  return DlssModuleFound{ path: ""; handle: 0; };
}

fn sym_quiet(h: Int, name: Str) -> Int
  requires: name.len() > 0
{
  if h == 0 { return 0; }
  let r = dl.dl_sym(h, name);
  if r.is_ok { return r.value; }
  return 0;
}

fn lookup_any(h1: Int, h2: Int, h3: Int, h4: Int, name: Str) -> Int
  requires: name.len() > 0
{
  let a1 = sym_quiet(h1, name);
  if a1 != 0 { return a1; }
  let a2 = sym_quiet(h2, name);
  if a2 != 0 { return a2; }
  let a3 = sym_quiet(h3, name);
  if a3 != 0 { return a3; }
  return sym_quiet(h4, name);
}

fn build_library(d: DlssModuleFound, c: DlssModuleFound, g: DlssModuleFound, r: DlssModuleFound) -> DlssLibrary
  requires: true
{
  let es = surface.dlss_table_entries();
  let n = es.len();
  var names: Vec[Str] = Vec[Str].new();
  var addrs: Vec[Int] = Vec[Int].new();
  var i = 0;
  while i < n {
    let e = es[i];
    var addr = 0;
    var resolved = "";
    if e.runtime.len() > 0 {
      addr = lookup_any(d.handle, c.handle, g.handle, r.handle, e.runtime);
      if addr != 0 { resolved = e.runtime; }
    }
    if addr == 0 {
      addr = lookup_any(d.handle, c.handle, g.handle, r.handle, e.name);
      if addr != 0 { resolved = e.name; }
    }
    names.push(resolved);
    addrs.push(addr);
    i = i + 1;
  }
  return DlssLibrary{
    h_dlss: d.handle; n_dlss: d.path;
    h_core: c.handle; n_core: c.path;
    h_fg: g.handle;   n_fg: g.path;
    h_rr: r.handle;   n_rr: r.path;
    count: n;
    names: names;
    addrs: addrs;
  };
}

fn any_handle(lib: &DlssLibrary) -> Bool
  requires: true
{
  return lib.h_dlss != 0 || lib.h_core != 0 || lib.h_fg != 0 || lib.h_rr != 0;
}

fn close_handles(lib: &DlssLibrary) -> Result[Unit, Str]
  requires: true
{
  var first_err = "";
  if lib.h_dlss != 0 {
    let r1 = dl.dl_close(lib.h_dlss);
    if !r1.is_ok { first_err = r1.error; }
  }
  if lib.h_core != 0 {
    let r2 = dl.dl_close(lib.h_core);
    if !r2.is_ok { if first_err.len() == 0 { first_err = r2.error; } }
  }
  if lib.h_fg != 0 {
    let r3 = dl.dl_close(lib.h_fg);
    if !r3.is_ok { if first_err.len() == 0 { first_err = r3.error; } }
  }
  if lib.h_rr != 0 {
    let r4 = dl.dl_close(lib.h_rr);
    if !r4.is_ok { if first_err.len() == 0 { first_err = r4.error; } }
  }
  if first_err.len() > 0 { return Err(first_err); }
  return Ok(());
}

/// Flag the classification of an already-built library: at least one of the
/// D3D12 anchors must resolve for the modules to be an NGX runtime.
fn anchors_ok(lib: &DlssLibrary) -> Bool
  requires: true
{
  let a = dlss_entry_addr(lib, "NVSDK_NGX_D3D12_Init");
  if a != 0 { return true; }
  let b = dlss_entry_addr(lib, "NVSDK_NGX_D3D12_CreateFeature");
  return b != 0;
}

/// Load the NGX runtime from the common locations only: the loader search
/// path (bare names; exe dir + System32 + PATH), the current directory and
/// `%SystemRoot%\System32`.  Returns DLSS_LOAD_ABSENT when nothing is found
/// (the suite's SKIP state); no binary is ever downloaded.
/// Complexity: O(modules x dirs).
pub fn dlss_load() -> Result[DlssLibrary, DlssLoadError]
  requires: true
{
  let dirs = module_dirs();
  let d = find_module(DLSS_DLL_DLSS, &dirs);
  let c1 = find_module(DLSS_DLL_CORE, &dirs);
  var c = c1;
  if c.handle == 0 {
    c = find_module(DLSS_DLL_CORE_ALT, &dirs);
  }
  let g = find_module(DLSS_DLL_FG, &dirs);
  let r = find_module(DLSS_DLL_RR, &dirs);
  let lib = build_library(d, c, g, r);
  if !any_handle(&lib) {
    return Err(DlssLoadError{
      kind: DLSS_LOAD_ABSENT;
      message: "no NGX runtime module found (nvngx_dlss.dll/nvngx.dll/_nvngx.dll/nvngx_dlssg.dll/nvngx_dlssd.dll; searched: " + dirs_desc(&dirs) + ")";
    });
  }
  if !anchors_ok(&lib) {
    let _ = close_handles(&lib);
    return Err(DlssLoadError{
      kind: DLSS_LOAD_ABI;
      message: "module(s) opened (" + dlss_module_summary(&lib) + ") but NGX D3D12 anchors are missing -- not an NGX runtime";
    });
  }
  return Ok(lib);
}

/// Load from explicit paths (hosts/games ship their own copies).  Empty
/// strings skip that module.  Same classification as `dlss_load`.
/// Complexity: O(modules).
pub fn dlss_load_from(dlss_path: Str, core_path: Str, fg_path: Str, rr_path: Str) -> Result[DlssLibrary, DlssLoadError]
  requires: true
{
  let d = explicit_module(dlss_path);
  let c = explicit_module(core_path);
  let g = explicit_module(fg_path);
  let r = explicit_module(rr_path);
  let lib = build_library(d, c, g, r);
  if !any_handle(&lib) {
    return Err(DlssLoadError{
      kind: DLSS_LOAD_ABSENT;
      message: "none of the explicit module paths opened (dlss='" + dlss_path + "', core='" + core_path + "', fg='" + fg_path + "', rr='" + rr_path + "')";
    });
  }
  if !anchors_ok(&lib) {
    let _ = close_handles(&lib);
    return Err(DlssLoadError{
      kind: DLSS_LOAD_ABI;
      message: "explicit module(s) opened (" + dlss_module_summary(&lib) + ") but NGX D3D12 anchors are missing -- not an NGX runtime";
    });
  }
  return Ok(lib);
}

/// Close every module handle of a loaded library.
/// Complexity: O(modules).
pub fn dlss_close(lib: &DlssLibrary) -> Result[Unit, Str]
  requires: true
{
  let r = close_handles(lib);
  if !r.is_ok { return Err(r.error); }
  return Ok(());
}

// =========================================================================
// Presence probe (classification only, no calls)
// =========================================================================

/// Probe the common locations without keeping anything open.  `found` is
/// true when at least one runtime module opened; the paths report what was
/// found and `searched` lists the locations.
/// Complexity: O(modules x dirs).
pub fn dlss_probe_present_path() -> DlssPresence
  requires: true
{
  let dirs = module_dirs();
  let d = find_module(DLSS_DLL_DLSS, &dirs);
  let c1 = find_module(DLSS_DLL_CORE, &dirs);
  var c = c1;
  if c.handle == 0 {
    c = find_module(DLSS_DLL_CORE_ALT, &dirs);
  }
  let g = find_module(DLSS_DLL_FG, &dirs);
  let r = find_module(DLSS_DLL_RR, &dirs);
  var found = false;
  if d.handle != 0 { found = true; }
  if c.handle != 0 { found = true; }
  if g.handle != 0 { found = true; }
  if r.handle != 0 { found = true; }
  if d.handle != 0 { let _ = dl.dl_close(d.handle); }
  if c.handle != 0 { let _ = dl.dl_close(c.handle); }
  if g.handle != 0 { let _ = dl.dl_close(g.handle); }
  if r.handle != 0 { let _ = dl.dl_close(r.handle); }
  return DlssPresence{
    found: found;
    dlss_path: d.path;
    core_path: c.path;
    fg_path: g.path;
    rr_path: r.path;
    searched: dirs_desc(&dirs);
  };
}

// =========================================================================
// Entry-table accessors
// =========================================================================

/// Number of declared table entries.
/// Complexity: O(1).
pub fn dlss_entry_count(lib: &DlssLibrary) -> Int
  requires: true
{
  return lib.count;
}

/// Index of a declared name in the table, or -1.
/// Complexity: O(entries).
pub fn dlss_entry_index(name: Str) -> Int
  requires: name.len() > 0
{
  let es = surface.dlss_table_entries();
  var i = 0;
  while i < es.len() {
    if string.str_compare(es[i].name, name) == 0 {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

/// Resolved address of a declared entry (0 = unresolved).
/// Complexity: O(entries).
pub fn dlss_entry_addr(lib: &DlssLibrary, name: Str) -> Int
  requires: name.len() > 0
{
  let i = dlss_entry_index(name);
  if i < 0 { return 0; }
  return lib.addrs[i];
}

/// True when the declared entry resolved on one of the loaded modules.
/// Complexity: O(entries).
pub fn dlss_entry_resolved(lib: &DlssLibrary, name: Str) -> Bool
  requires: name.len() > 0
{
  return dlss_entry_addr(lib, name) != 0;
}

/// The export spelling that resolved for a declared entry ("" if none).
/// Complexity: O(entries).
pub fn dlss_entry_resolved_as(lib: &DlssLibrary, name: Str) -> Str
  requires: name.len() > 0
{
  let i = dlss_entry_index(name);
  if i < 0 { return ""; }
  return lib.names[i];
}

/// Count of resolved entries over the whole table.
/// Complexity: O(entries).
pub fn dlss_resolved_count(lib: &DlssLibrary) -> Int
  requires: true
{
  var n = 0;
  var i = 0;
  while i < lib.addrs.len() {
    if lib.addrs[i] != 0 { n = n + 1; }
    i = i + 1;
  }
  return n;
}

/// Count of resolved entries in one group (DLSS_GROUP_*).
/// Complexity: O(entries).
pub fn dlss_resolved_in_group(lib: &DlssLibrary, group: Int) -> Int
  requires: group >= 0
  requires: group <= 5
{
  let es = surface.dlss_table_entries();
  var n = 0;
  var i = 0;
  while i < es.len() {
    if es[i].group == group {
      if lib.addrs[i] != 0 { n = n + 1; }
    }
    i = i + 1;
  }
  return n;
}

/// Names (declared) of the resolved entries in one group.
/// Complexity: O(entries).
pub fn dlss_resolved_names(lib: &DlssLibrary, group: Int) -> Vec[Str]
  requires: group >= 0
  requires: group <= 5
{
  let es = surface.dlss_table_entries();
  var out: Vec[Str] = Vec[Str].new();
  var i = 0;
  while i < es.len() {
    if es[i].group == group {
      if lib.addrs[i] != 0 { out.push(es[i].name); }
    }
    i = i + 1;
  }
  return out;
}

/// Names (declared) of the unresolved entries in one group.
/// Complexity: O(entries).
pub fn dlss_unresolved_names(lib: &DlssLibrary, group: Int) -> Vec[Str]
  requires: group >= 0
  requires: group <= 5
{
  let es = surface.dlss_table_entries();
  var out: Vec[Str] = Vec[Str].new();
  var i = 0;
  while i < es.len() {
    if es[i].group == group {
      if lib.addrs[i] == 0 { out.push(es[i].name); }
    }
    i = i + 1;
  }
  return out;
}

/// One-line module summary ("dlss=..., core=..., ...") for messages.
/// Complexity: O(1).
pub fn dlss_module_summary(lib: &DlssLibrary) -> Str
  requires: true
{
  return "dlss=" + lib.n_dlss + " core=" + lib.n_core + " fg=" + lib.n_fg + " rr=" + lib.n_rr;
}

// =========================================================================
// Parameter C API (typed wrappers; all 16 entries)
// =========================================================================

// Owned out-param slots: C out-params land in an XIOM-owned byte buffer
// (B-05/B-11 workaround -- no alloc/free pair runs near confinement) and
// are read back byte-wise / through ffi.safe_ptr_from_raw wrappers of the
// same buffer (B-12: never a cast-call fp return; B-20/B-24: the memory is
// ours, and it is never freed by the wrapper -- owned = false).

fn slot_new(n: Int) -> Vec[UInt8]
  requires: n > 0
{
  var v: Vec[UInt8] = Vec[UInt8].new();
  var i = 0;
  while i < n {
    v.push(0 as UInt8);
    i = i + 1;
  }
  return v;
}

fn slot_i32(v: &Vec[UInt8]) -> Int
  requires: v.len() >= 4
{
  return (v[0] as Int) | ((v[1] as Int) << 8) | ((v[2] as Int) << 16) | ((v[3] as Int) << 24);
}

fn slot_i64(v: &Vec[UInt8]) -> Int
  requires: v.len() >= 8
{
  return slot_i32(v)
    | ((v[4] as Int) << 32) | ((v[5] as Int) << 40)
    | ((v[6] as Int) << 48) | ((v[7] as Int) << 56);
}

fn slot_f32(v: &Vec[UInt8]) -> Float32
  requires: v.len() >= 4
{
  let r = ffi.safe_ptr_from_raw(v.as_mut_ptr(), 4);
  if !r.is_ok { return 0.0; }
  let s = r.value;
  let vr = ffi.safe_ptr_read_f32(&s, 0);
  if vr.is_ok { return vr.value; }
  return 0.0;
}

fn slot_f64(v: &Vec[UInt8]) -> Float64
  requires: v.len() >= 8
{
  let r = ffi.safe_ptr_from_raw(v.as_mut_ptr(), 8);
  if !r.is_ok { return 0.0; }
  let s = r.value;
  let vr = ffi.safe_ptr_read_f64(&s, 0);
  if vr.is_ok { return vr.value; }
  return 0.0;
}

/// NVSDK_NGX_Parameter_SetUI.  Bool = entry resolved (call performed).
/// Complexity: O(entries).
pub fn dlss_param_set_ui(lib: &DlssLibrary, params: Int, key: Str, value: Int) -> Bool
  requires: params != 0
{
  let p = dlss_entry_addr(lib, "NVSDK_NGX_Parameter_SetUI");
  if p == 0 { return false; }
  unsafe {
    let f_set = p as fn(Int, *UInt8, Int32);
    f_set(params, key.c_str(), value as Int32);
  }
  return true;
}

