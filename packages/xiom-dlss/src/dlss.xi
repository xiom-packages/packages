}

/// NVSDK_NGX_Parameter_GetF (B-12 workaround: float lands in an owned slot
/// and is read through xiom.ffi, never as a cast-call return).
/// Complexity: O(entries).
pub fn dlss_param_get_f(lib: &DlssLibrary, params: Int, key: Str) -> DlssGetF32
  requires: params != 0
{
  var out = DlssGetF32{ rc: DLSS_RC_UNRESOLVED; value: 0.0; };
