// =========================================================================
// Capability queries + DLSS-SR optimal settings
// =========================================================================

/// Feature availability through the capability parameter
/// ("SuperSampling.Available" / "FrameGeneration.Available" /
/// "SuperSamplingDenoising.Available"); ok=false when the parameter API is
/// unresolved, value=1 when the runtime reports the feature available.
/// Complexity: O(entries).
pub fn dlss_feature_available(lib: &DlssLibrary, capability_params: Int, key: Str) -> DlssGetInt
  requires: capability_params != 0
{
  return dlss_param_get_ui(lib, capability_params, key);
}

/// DLSS-SR available (NVSDK_NGX_Parameter_SuperSampling_Available).
/// Complexity: O(entries).
pub fn dlss_sr_available(lib: &DlssLibrary, capability_params: Int) -> DlssGetInt
  requires: capability_params != 0
{
  return dlss_param_get_ui(lib, capability_params, surface.NVSDK_NGX_Parameter_SuperSampling_Available);
}

/// DLSS-FG available (NVSDK_NGX_Parameter_FrameGeneration_Available).
/// Complexity: O(entries).
pub fn dlss_fg_available(lib: &DlssLibrary, capability_params: Int) -> DlssGetInt
  requires: capability_params != 0
{
  return dlss_param_get_ui(lib, capability_params, surface.NVSDK_NGX_Parameter_FrameGeneration_Available);
}

/// DLSS-RR available (NVSDK_NGX_Parameter_SuperSamplingDenoising_Available).
/// Complexity: O(entries).
pub fn dlss_rr_available(lib: &DlssLibrary, capability_params: Int) -> DlssGetInt
  requires: capability_params != 0
{
  return dlss_param_get_ui(lib, capability_params, surface.NVSDK_NGX_Parameter_SuperSamplingDenoising_Available);
}

/// The NGX_DLSS_GET_OPTIMAL_SETTINGS sequence, written independently from
/// the pinned helper (set Width/Height/PerfQualityValue/RTXValue, fetch the
/// DLSSOptimalSettingsCallback through the parameter API, call it, read
/// OutWidth/OutHeight/Sharpness and the dynamic min/max bounds).
/// ok=false when the parameter API or the callback is absent; rc carries
/// the callback result (NVSDK_NGX_RESULT_FAIL_OUT_OF_DATE when the runtime
/// has no callback -- the upstream-documented reason).
/// Complexity: O(entries).
pub fn dlss_sr_optimal_settings(lib: &DlssLibrary, params: Int, user_w: Int, user_h: Int, perf_quality: Int) -> DlssOptimalSettings
  requires: params != 0
  requires: user_w > 0
  requires: user_h > 0
{
  var out = DlssOptimalSettings{
    ok: false; rc: DLSS_RC_UNRESOLVED;
    optimal_width: 0; optimal_height: 0;
    max_width: 0; max_height: 0;
    min_width: 0; min_height: 0;
    sharpness: 0.0;
  };
  let cb = dlss_param_get_void_pointer(lib, params, surface.NVSDK_NGX_Parameter_DLSSOptimalSettingsCallback);
  if cb.rc == DLSS_RC_UNRESOLVED { return out; }
  if cb.value == 0 {
    out.rc = NVSDK_NGX_RESULT_FAIL_OUT_OF_DATE;
    return out;
  }
  let _ = dlss_param_set_ui(lib, params, surface.NVSDK_NGX_Parameter_Width, user_w);
  let _ = dlss_param_set_ui(lib, params, surface.NVSDK_NGX_Parameter_Height, user_h);
  let _ = dlss_param_set_i(lib, params, surface.NVSDK_NGX_Parameter_PerfQualityValue, perf_quality);
  let _ = dlss_param_set_i(lib, params, surface.NVSDK_NGX_Parameter_RTXValue, 0);
  let rc = unsafe {
    let f_cb = cb.value as fn(Int) -> Int32;
    f_cb(params) as Int
  };
  out.rc = rc;
  if dlss_failed(rc) { return out; }
  let w = dlss_param_get_ui(lib, params, surface.NVSDK_NGX_Parameter_OutWidth);
  let h = dlss_param_get_ui(lib, params, surface.NVSDK_NGX_Parameter_OutHeight);
  out.optimal_width = w.value;
  out.optimal_height = h.value;
  out.max_width = w.value;
  out.max_height = h.value;
  out.min_width = w.value;
  out.min_height = h.value;
  let mw = dlss_param_get_ui(lib, params, surface.NVSDK_NGX_Parameter_DLSS_Get_Dynamic_Max_Render_Width);
  let mh = dlss_param_get_ui(lib, params, surface.NVSDK_NGX_Parameter_DLSS_Get_Dynamic_Max_Render_Height);
  let nw = dlss_param_get_ui(lib, params, surface.NVSDK_NGX_Parameter_DLSS_Get_Dynamic_Min_Render_Width);
  let nh = dlss_param_get_ui(lib, params, surface.NVSDK_NGX_Parameter_DLSS_Get_Dynamic_Min_Render_Height);
  if mw.rc != DLSS_RC_UNRESOLVED && mw.value > 0 { out.max_width = mw.value; }
  if mh.rc != DLSS_RC_UNRESOLVED && mh.value > 0 { out.max_height = mh.value; }
  if nw.rc != DLSS_RC_UNRESOLVED && nw.value > 0 { out.min_width = nw.value; }
  if nh.rc != DLSS_RC_UNRESOLVED && nh.value > 0 { out.min_height = nh.value; }
  let sh = dlss_param_get_f(lib, params, surface.NVSDK_NGX_Parameter_Sharpness);
  if sh.rc != DLSS_RC_UNRESOLVED { out.sharpness = sh.value; }
  out.ok = true;
  return out;
}

// =========================================================================
// Core D3D12 typed flow (init -> params -> create/evaluate/release)
// =========================================================================

/// NVSDK_NGX_D3D12_Init (app_id u64; InFeatureInfo = 0; version pinned).
/// `data_path_wide` is an XIOM-owned UTF-16LE buffer (dlss_wide_path).
/// Complexity: O(entries).
pub fn dlss_d3d12_init(lib: &DlssLibrary, app_id: Int, data_path_wide: &Vec[UInt8], device: Int) -> Int
  requires: data_path_wide.len() >= 2
{
  let p = dlss_entry_addr(lib, "NVSDK_NGX_D3D12_Init");
  if p == 0 { return DLSS_RC_UNRESOLVED; }
  return unsafe {
    let f_init = p as fn(Int, *UInt8, Int, Int, Int32) -> Int32;
    f_init(app_id, data_path_wide.as_mut_ptr(), device, 0, NVSDK_NGX_VERSION_API as Int32) as Int
  };
}

/// NVSDK_NGX_D3D12_Init_with_ProjectID (the runtime export spelling
/// `NVSDK_NGX_D3D12_Init_ProjectID` is tried first by the table).
/// Complexity: O(entries).
pub fn dlss_d3d12_init_projectid(lib: &DlssLibrary, project_id: Str, engine_type: Int, engine_version: Str, data_path_wide: &Vec[UInt8], device: Int) -> Int
  requires: project_id.len() > 0
  requires: data_path_wide.len() >= 2
{
  let p = dlss_entry_addr(lib, "NVSDK_NGX_D3D12_Init_with_ProjectID");
  if p == 0 { return DLSS_RC_UNRESOLVED; }
  return unsafe {
    let f_init = p as fn(*UInt8, Int32, *UInt8, *UInt8, Int, Int, Int32) -> Int32;
    f_init(project_id.c_str(), engine_type as Int32, engine_version.c_str(), data_path_wide.as_mut_ptr(), device, 0, NVSDK_NGX_VERSION_API as Int32) as Int
  };
}

/// NVSDK_NGX_D3D12_Shutdown1 (device).
/// Complexity: O(entries).
pub fn dlss_d3d12_shutdown(lib: &DlssLibrary, device: Int) -> Int
  requires: true
{
  let p = dlss_entry_addr(lib, "NVSDK_NGX_D3D12_Shutdown1");
  if p == 0 { return DLSS_RC_UNRESOLVED; }
  return unsafe {
    let f_shutdown = p as fn(Int) -> Int32;
    f_shutdown(device) as Int
  };
}

/// NVSDK_NGX_D3D12_Shutdown (legacy, no device).
/// Complexity: O(entries).
pub fn dlss_d3d12_shutdown_legacy(lib: &DlssLibrary) -> Int
  requires: true
{
  let p = dlss_entry_addr(lib, "NVSDK_NGX_D3D12_Shutdown");
  if p == 0 { return DLSS_RC_UNRESOLVED; }
  return unsafe {
    let f_shutdown = p as fn() -> Int32;
    f_shutdown() as Int
  };
}

fn call_parameters_out(lib: &DlssLibrary, name: Str) -> DlssHandleOutcome
  requires: name.len() > 0
{
  var out = DlssHandleOutcome{ rc: DLSS_RC_UNRESOLVED; handle: 0; };
  let p = dlss_entry_addr(lib, name);
  if p == 0 { return out; }
  var slot = slot_new(8);
  out.rc = unsafe {
    let f_call = p as fn(*UInt8) -> Int32;
    f_call(slot.as_mut_ptr()) as Int
  };
  out.handle = read_slot_i64(&slot);
  return out;
}

/// NVSDK_NGX_D3D12_GetParameters -- allocate a parameter set owned by the
/// runtime (returned as an opaque handle).
/// Complexity: O(entries).
pub fn dlss_d3d12_get_parameters(lib: &DlssLibrary) -> DlssHandleOutcome
  requires: true
{
  return call_parameters_out(lib, "NVSDK_NGX_D3D12_GetParameters");
}

/// NVSDK_NGX_D3D12_AllocateParameters (app-owned parameter set).
/// Complexity: O(entries).
pub fn dlss_d3d12_allocate_parameters(lib: &DlssLibrary) -> DlssHandleOutcome
  requires: true
{
  return call_parameters_out(lib, "NVSDK_NGX_D3D12_AllocateParameters");
}

/// NVSDK_NGX_D3D12_GetCapabilityParameters (read-only capability set; the
/// parameter set used for availability queries).
/// Complexity: O(entries).
pub fn dlss_d3d12_get_capability_parameters(lib: &DlssLibrary) -> DlssHandleOutcome
  requires: true
{
  return call_parameters_out(lib, "NVSDK_NGX_D3D12_GetCapabilityParameters");
}

/// NVSDK_NGX_D3D12_DestroyParameters.
/// Complexity: O(entries).
pub fn dlss_d3d12_destroy_parameters(lib: &DlssLibrary, params: Int) -> Int
  requires: params != 0
{
  let p = dlss_entry_addr(lib, "NVSDK_NGX_D3D12_DestroyParameters");
  if p == 0 { return DLSS_RC_UNRESOLVED; }
  return unsafe {
    let f_call = p as fn(Int) -> Int32;
    f_call(params) as Int
  };
}

/// NVSDK_NGX_D3D12_GetScratchBufferSize.
/// Complexity: O(entries).
pub fn dlss_d3d12_get_scratch_buffer_size(lib: &DlssLibrary, feature: Int, params: Int) -> DlssSizeOutcome
  requires: params != 0
{
  var out = DlssSizeOutcome{ rc: DLSS_RC_UNRESOLVED; size: 0; };
  let p = dlss_entry_addr(lib, "NVSDK_NGX_D3D12_GetScratchBufferSize");
  if p == 0 { return out; }
  var slot = slot_new(8);
  out.rc = unsafe {
    let f_call = p as fn(Int32, Int, *UInt8) -> Int32;
    f_call(feature as Int32, params, slot.as_mut_ptr()) as Int
  };
  out.size = read_slot_i64(&slot);
  return out;
}

/// NVSDK_NGX_D3D12_CreateFeature (feature = NVSDK_NGX_FEATURE_*, params
/// pre-filled through the parameter API; handle returned as an owned
/// 8-byte slot value).
/// Complexity: O(entries).
pub fn dlss_d3d12_create_feature(lib: &DlssLibrary, cmd_list: Int, feature: Int, params: Int) -> DlssHandleOutcome
  requires: params != 0
{
  var out = DlssHandleOutcome{ rc: DLSS_RC_UNRESOLVED; handle: 0; };
  let p = dlss_entry_addr(lib, "NVSDK_NGX_D3D12_CreateFeature");
  if p == 0 { return out; }
  var slot = slot_new(8);
  out.rc = unsafe {
    let f_call = p as fn(Int, Int32, Int, *UInt8) -> Int32;
    f_call(cmd_list, feature as Int32, params, slot.as_mut_ptr()) as Int
  };
  out.handle = read_slot_i64(&slot);
  return out;
}

/// NVSDK_NGX_D3D12_ReleaseFeature.
/// Complexity: O(entries).
pub fn dlss_d3d12_release_feature(lib: &DlssLibrary, handle: Int) -> Int
  requires: handle != 0
{
  let p = dlss_entry_addr(lib, "NVSDK_NGX_D3D12_ReleaseFeature");
  if p == 0 { return DLSS_RC_UNRESOLVED; }
  return unsafe {
    let f_call = p as fn(Int) -> Int32;
    f_call(handle) as Int
  };
}

/// NVSDK_NGX_D3D12_EvaluateFeature (callback slot = 0).
/// Complexity: O(entries).
pub fn dlss_d3d12_evaluate_feature(lib: &DlssLibrary, cmd_list: Int, handle: Int, params: Int) -> Int
  requires: handle != 0
  requires: params != 0
{
  let p = dlss_entry_addr(lib, "NVSDK_NGX_D3D12_EvaluateFeature");
  if p == 0 { return DLSS_RC_UNRESOLVED; }
  return unsafe {
    let f_call = p as fn(Int, Int, Int, Int) -> Int32;
    f_call(cmd_list, handle, params, 0) as Int
  };
}

/// NVSDK_NGX_D3D12_GetFeatureRequirements (feature support query; the
/// discovery-info and requirement structs follow the pinned header layouts
/// and are passed as caller-built pointers -- see SPEC.md section 5).
/// Complexity: O(entries).
pub fn dlss_d3d12_get_feature_requirements(lib: &DlssLibrary, adapter: Int, discovery_info: Int, out_requirement: Int) -> Int
  requires: adapter != 0
  requires: discovery_info != 0
  requires: out_requirement != 0
{
  let p = dlss_entry_addr(lib, "NVSDK_NGX_D3D12_GetFeatureRequirements");
  if p == 0 { return DLSS_RC_UNRESOLVED; }
  return unsafe {
    let f_call = p as fn(Int, Int, Int) -> Int32;
    f_call(adapter, discovery_info, out_requirement) as Int
  };
}

/// The DLSS-SR create sequence from the pinned helper (length checks +
/// parameter keys in documented order), then CreateFeature:
/// sets Width/Height/OutWidth/OutHeight (UI), PerfQualityValue and the
/// create flags (I).
/// Complexity: O(entries + sets).
pub fn dlss_sr_create_d3d12(lib: &DlssLibrary, cmd_list: Int, params: Int, in_w: Int, in_h: Int, out_w: Int, out_h: Int, perf_quality: Int, create_flags: Int) -> DlssHandleOutcome
  requires: params != 0
  requires: in_w > 0
  requires: in_h > 0
  requires: out_w > 0
  requires: out_h > 0
{
  let _ = dlss_param_set_ui(lib, params, surface.NVSDK_NGX_Parameter_Width, in_w);
  let _ = dlss_param_set_ui(lib, params, surface.NVSDK_NGX_Parameter_Height, in_h);
  let _ = dlss_param_set_ui(lib, params, surface.NVSDK_NGX_Parameter_OutWidth, out_w);
  let _ = dlss_param_set_ui(lib, params, surface.NVSDK_NGX_Parameter_OutHeight, out_h);
  let _ = dlss_param_set_i(lib, params, surface.NVSDK_NGX_Parameter_PerfQualityValue, perf_quality);
  let _ = dlss_param_set_i(lib, params, surface.NVSDK_NGX_Parameter_DLSS_Feature_Create_Flags, create_flags);
  return dlss_d3d12_create_feature(lib, cmd_list, NVSDK_NGX_FEATURE_SUPER_SAMPLING, params);
}

/// The DLSS-SR evaluate sequence from the pinned helper (core inputs):
/// sets Color/Output/Depth/MotionVectors (resources), Jitter_Offset_X/Y,
/// Sharpness, MV_Scale_X/Y, Reset (with the upstream 0 -> 1.0 defaulting
/// for MV scale), then EvaluateFeature.
/// Complexity: O(entries + sets).
pub fn dlss_sr_evaluate_d3d12(lib: &DlssLibrary, cmd_list: Int, handle: Int, params: Int, color: Int, output: Int, depth: Int, motion_vectors: Int, jitter_x: Float32, jitter_y: Float32, mv_scale_x: Float32, mv_scale_y: Float32, sharpness: Float32, reset: Int) -> Int
  requires: handle != 0
  requires: params != 0
  requires: color != 0
  requires: output != 0
{
  let _ = dlss_param_set_d3d12_resource(lib, params, surface.NVSDK_NGX_Parameter_Color, color);
  let _ = dlss_param_set_d3d12_resource(lib, params, surface.NVSDK_NGX_Parameter_Output, output);
  let _ = dlss_param_set_d3d12_resource(lib, params, surface.NVSDK_NGX_Parameter_Depth, depth);
  let _ = dlss_param_set_d3d12_resource(lib, params, surface.NVSDK_NGX_Parameter_MotionVectors, motion_vectors);
  let _ = dlss_param_set_f(lib, params, surface.NVSDK_NGX_Parameter_Jitter_Offset_X, jitter_x);
  let _ = dlss_param_set_f(lib, params, surface.NVSDK_NGX_Parameter_Jitter_Offset_Y, jitter_y);
  let _ = dlss_param_set_f(lib, params, surface.NVSDK_NGX_Parameter_Sharpness, sharpness);
  var sx = mv_scale_x;
  if sx == 0.0 { sx = 1.0; }
  var sy = mv_scale_y;
  if sy == 0.0 { sy = 1.0; }
  let _ = dlss_param_set_f(lib, params, surface.NVSDK_NGX_Parameter_MV_Scale_X, sx);
  let _ = dlss_param_set_f(lib, params, surface.NVSDK_NGX_Parameter_MV_Scale_Y, sy);
  let _ = dlss_param_set_i(lib, params, surface.NVSDK_NGX_Parameter_Reset, reset);
  return dlss_d3d12_evaluate_feature(lib, cmd_list, handle, params);
}

/// The DLSS-SR destroy sequence: ReleaseFeature + DestroyParameters.
/// Returns the first failing rc (NVSDK_NGX_RESULT_SUCCESS when both pass).
/// DLSS_RC_UNRESOLVED is propagated when an entry is missing.
/// Complexity: O(entries).
pub fn dlss_sr_destroy_d3d12(lib: &DlssLibrary, handle: Int, params: Int) -> Int
  requires: handle != 0
  requires: params != 0
{
  let r1 = dlss_d3d12_release_feature(lib, handle);
  let r2 = dlss_d3d12_destroy_parameters(lib, params);
  if r1 == DLSS_RC_UNRESOLVED { return r1; }
  if r2 == DLSS_RC_UNRESOLVED { return r2; }
  if dlss_failed(r1) { return r1; }
  if dlss_failed(r2) { return r2; }
  return NVSDK_NGX_RESULT_SUCCESS;
}

// =========================================================================
// UTF-16LE path helper (Init's InApplicationDataPath is wchar_t*)
// =========================================================================

/// ASCII path -> UTF-16LE, NUL-terminated, as an XIOM-owned buffer.
/// Characters above U+007F are not supported (documented; Init paths are
/// application data dirs, which are the app's own choice).
/// Complexity: O(len).
pub fn dlss_wide_path(s: Str) -> Vec[UInt8]
  requires: s.len() >= 0
{
  var out: Vec[UInt8] = Vec[UInt8].new();
  var i = 0;
  while i < s.len() {
    out.push(string.byte_at(s, i));
    out.push(0 as UInt8);
    i = i + 1;
  }
  out.push(0 as UInt8);
  out.push(0 as UInt8);
  return out;
}

