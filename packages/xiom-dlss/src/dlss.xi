fn read_slot_i32(slot: &Vec[UInt8]) -> Int
  requires: slot.len() >= 4
{
  return slot_i32(slot);
}

fn read_slot_i64(slot: &Vec[UInt8]) -> Int
  requires: slot.len() >= 8
{
  return slot_i64(slot);
}

/// NVSDK_NGX_Parameter_GetUI (out-param through an owned 4-byte slot).
/// Complexity: O(entries).
pub fn dlss_param_get_ui(lib: &DlssLibrary, params: Int, key: Str) -> DlssGetInt
  requires: params != 0
{
  var out = DlssGetInt{ rc: DLSS_RC_UNRESOLVED; value: 0; };
  let p = dlss_entry_addr(lib, "NVSDK_NGX_Parameter_GetUI");
  if p == 0 { return out; }
  var slot = slot_new(4);
  out.rc = unsafe {
    let f_get = p as fn(Int, *UInt8, *UInt8) -> Int32;
    f_get(params, key.c_str(), slot.as_mut_ptr()) as Int
  };
  out.value = read_slot_i32(&slot);
  return out;
}

/// NVSDK_NGX_Parameter_GetI.
/// Complexity: O(entries).
pub fn dlss_param_get_i(lib: &DlssLibrary, params: Int, key: Str) -> DlssGetInt
  requires: params != 0
{
  var out = DlssGetInt{ rc: DLSS_RC_UNRESOLVED; value: 0; };
  let p = dlss_entry_addr(lib, "NVSDK_NGX_Parameter_GetI");
  if p == 0 { return out; }
  var slot = slot_new(4);
  out.rc = unsafe {
    let f_get = p as fn(Int, *UInt8, *UInt8) -> Int32;
    f_get(params, key.c_str(), slot.as_mut_ptr()) as Int
  };
  out.value = read_slot_i32(&slot);
  return out;
}

/// NVSDK_NGX_Parameter_GetULL (8-byte slot).
