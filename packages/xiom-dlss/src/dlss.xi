// XIOM -- xiom.dlss: NVIDIA DLSS / NGX bindings (CLOSED-SDK pattern).
// Copyright (c) 2026 Eleftherios Notas and The XIOM Authors
// Licensed under the MIT or Apache-2.0 license, at your option.
//
// The NVIDIA DLSS SDK is under the NVIDIA RTX SDKs License (CLOSED,
// reference-only).  NOTHING from NVIDIA is vendored into this package: no
// headers, no code, no binaries.  `surface.xi` (generated by
// tools/gen_surface.py from the pinned public headers of the reference
// clone) and this module are INDEPENDENT declarations of interface facts
// -- export names, parameter key strings, numeric codes -- per the
// CLOSED-SDK pattern (FFmpeg precedent; PROVENANCE.md records the pin,
// the license and the exact provenance of every name).
//
// Runtime model: DLSS features execute inside NVIDIA-provided modules that
// this package dynamic-loads and NEVER ships:
//
//   * `nvngx_dlss.dll`  -- DLSS-SR (super resolution) feature module,
//   * `nvngx.dll` / `_nvngx.dll` -- the NGX core proxy (driver install),
//   * `nvngx_dlssg.dll` -- DLSS-FG (frame generation) feature module,
//   * `nvngx_dlssd.dll` -- DLSS-RR (ray reconstruction) feature module.
//
// When none is present the loaders classify ABSENT (the suite reports a
// typed SKIP -- the runtime is not shipped and the suite never downloads
// one); common locations are probed, and an explicit-path loader exists for
// hosts/games that ship their own copy.  When a module loads, every entry
// of the declared table is resolved by name and the missing ones are
// reported as data.
//
// Reflex: the pinned headers do NOT describe the Reflex SDK (no PCL
// stats/marker declarations anywhere in include/ -- verified by scan at the
// pin), so no Reflex surface is declared here; see DLSS_REFLEX_COVERED.
//
// v0.64.4 discipline: no `x as *UInt8` handle casts (B-25); `Int 0` for
// absent pointers, never bare `null` (B-23); no foreign-pointer reads --
// C out-params land in XIOM-owned SafePtr slots read via xiom.ffi helpers
// (B-20/B-24/B-11); no pointer arithmetic; one owned slot per out-param;
// no fp RETURNS through cast calls (B-12 -- slot + ffi reads instead); flat
// outcome structs only, never Result[Option[T]] (B-26); Str equality via
// string.str_compare; fn-pointer locals are `f_`-prefixed (B-10); no
// fn-typed values are exported to C (B-13).
//
// All `unsafe`/dynamic-loading lives in this module (G5).

module xiom.dlss

use xiom.ffi;
use xiom.ffi.dl;
use xiom.io;
use xiom.string;
use xiom.dlss.surface;

// =========================================================================
// Load classification and outcome types
// =========================================================================

/// No runtime module could be found or opened (typed SKIP).
pub const DLSS_LOAD_ABSENT: Int = 0;

/// A module with one of the runtime names opened but the NGX entry-point
/// anchors are missing -- not an NGX runtime.
pub const DLSS_LOAD_ABI: Int = 1;

/// Sentinel returned by typed wrappers when the entry point is unresolved
/// (never a valid NGX result code).
pub const DLSS_RC_UNRESOLVED: Int = -1;

/// Loader classification error (G3 typed errors, flat shape).
pub type DlssLoadError = {
  kind: Int;      // DLSS_LOAD_*
  message: Str;
}

/// Runtime module selectors (module slots of a loaded library).
pub const DLSS_MODULE_DLSS: Int = 0;  // nvngx_dlss.dll  -- DLSS-SR
pub const DLSS_MODULE_CORE: Int = 1;  // nvngx.dll/_nvngx.dll -- NGX core
pub const DLSS_MODULE_FG: Int = 2;    // nvngx_dlssg.dll -- DLSS-FG
pub const DLSS_MODULE_RR: Int = 3;    // nvngx_dlssd.dll -- DLSS-RR

/// Module file names (Windows x64); these are the names the SDK-side loader
/// itself uses (nvsdk_ngx_loader.h documents the core search).
pub const DLSS_DLL_DLSS: Str = "nvngx_dlss.dll";
pub const DLSS_DLL_CORE: Str = "nvngx.dll";
pub const DLSS_DLL_CORE_ALT: Str = "_nvngx.dll";
pub const DLSS_DLL_FG: Str = "nvngx_dlssg.dll";
pub const DLSS_DLL_RR: Str = "nvngx_dlssd.dll";

// --- flat outcomes -------------------------------------------------------

/// Result of a `Get*` parameter call: rc is the NVSDK_NGX_Result the
/// runtime returned (DLSS_RC_UNRESOLVED when the entry was not resolved).
pub type DlssGetInt = {
  rc: Int;
  value: Int;
}

/// Result of `GetF` (read through an XIOM-owned slot): rc + float value.
pub type DlssGetF32 = {
  rc: Int;
  value: Float32;
}

/// Result of `GetD`.
pub type DlssGetF64 = {
  rc: Int;
  value: Float64;
}

/// Result of a handle out-param call (CreateFeature, GetParameters, ...).
pub type DlssHandleOutcome = {
  rc: Int;
  handle: Int;
}

/// Result of GetScratchBufferSize.
pub type DlssSizeOutcome = {
  rc: Int;
  size: Int;
}

/// DLSS-SR optimal settings (NGX_DLSS_GET_OPTIMAL_SETTINGS sequence).
pub type DlssOptimalSettings = {
  ok: Bool;
  rc: Int;
  optimal_width: Int;
  optimal_height: Int;
  max_width: Int;
  max_height: Int;
  min_width: Int;
  min_height: Int;
  sharpness: Float32;
}

/// Presence probe outcome (public-loader classification, no calls made).
pub type DlssPresence = {
  found: Bool;
  dlss_path: Str;
  core_path: Str;
  fg_path: Str;
  rr_path: Str;
  searched: Str;
}

// =========================================================================
// NGX result codes (nvsdk_ngx_defs.h) and SUCCEED/FAILED macros
// =========================================================================

pub const NVSDK_NGX_RESULT_SUCCESS: Int = 1;
pub const NVSDK_NGX_RESULT_FAIL: Int = 3132620800;  // 0xBAD00000
pub const NVSDK_NGX_RESULT_FAIL_FEATURE_NOT_SUPPORTED: Int = 3132620801;
pub const NVSDK_NGX_RESULT_FAIL_PLATFORM_ERROR: Int = 3132620802;
pub const NVSDK_NGX_RESULT_FAIL_FEATURE_ALREADY_EXISTS: Int = 3132620803;
pub const NVSDK_NGX_RESULT_FAIL_FEATURE_NOT_FOUND: Int = 3132620804;
pub const NVSDK_NGX_RESULT_FAIL_INVALID_PARAMETER: Int = 3132620805;
pub const NVSDK_NGX_RESULT_FAIL_SCRATCH_BUFFER_TOO_SMALL: Int = 3132620806;
pub const NVSDK_NGX_RESULT_FAIL_NOT_INITIALIZED: Int = 3132620807;
pub const NVSDK_NGX_RESULT_FAIL_UNSUPPORTED_INPUT_FORMAT: Int = 3132620808;
pub const NVSDK_NGX_RESULT_FAIL_RW_FLAG_MISSING: Int = 3132620809;
pub const NVSDK_NGX_RESULT_FAIL_MISSING_INPUT: Int = 3132620810;
pub const NVSDK_NGX_RESULT_FAIL_UNABLE_TO_INITIALIZE_FEATURE: Int = 3132620811;
pub const NVSDK_NGX_RESULT_FAIL_OUT_OF_DATE: Int = 3132620812;
pub const NVSDK_NGX_RESULT_FAIL_OUT_OF_GPU_MEMORY: Int = 3132620813;
pub const NVSDK_NGX_RESULT_FAIL_UNSUPPORTED_FORMAT: Int = 3132620814;
pub const NVSDK_NGX_RESULT_FAIL_UNABLE_TO_WRITE_TO_APP_DATA_PATH: Int = 3132620815;
pub const NVSDK_NGX_RESULT_FAIL_UNSUPPORTED_PARAMETER: Int = 3132620816;
pub const NVSDK_NGX_RESULT_FAIL_DENIED: Int = 3132620817;
pub const NVSDK_NGX_RESULT_FAIL_NOT_IMPLEMENTED: Int = 3132620818;

/// NVSDK_NGX_SUCCEED.  The pinned result space is Success (1) or
/// NVSDK_NGX_RESULT_FAIL | N with N in 0..18, so the boundary form below is
/// equivalent to the upstream `(rc & 0xFFF00000) != 0xBAD00000` macro over
/// every code a runtime can return.  The bitwise macro form is not usable on
/// this pin: bitwise ops (and integer division) on values >= 2^31 miscompile
/// (v0.64.4; repro `docs/repro/bindings-pilot/bigint-bitops/`; e.g.
/// 0xBAD00000 >> 20 yields 2987, not 2989).  The suite pins this equivalence.
/// Complexity: O(1).
pub fn dlss_succeeded(rc: Int) -> Bool
  requires: true
{
  return !dlss_failed(rc);
}

/// NVSDK_NGX_FAILED: rc is one of the 19 pinned failure codes
/// (NVSDK_NGX_RESULT_FAIL | 0..18).
/// Complexity: O(1).
pub fn dlss_failed(rc: Int) -> Bool
  requires: true
{
  let d = rc - NVSDK_NGX_RESULT_FAIL;
  return d >= 0 && d <= 18;
}

