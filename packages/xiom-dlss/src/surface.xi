pub const DLSS_EPARAM_COUNT: Int = 74;

/// Build the C key string for an effective-key code: "#" for code 0,
/// else "#" followed by the raw byte.  Uses the byte-builder because
/// XIOM string literals cannot express raw control bytes.
/// Complexity: O(1).
pub fn dlss_eparameter_key(code: Int) -> Str
  requires: code >= 0
  requires: code <= 255
{
  var sb: Vec[UInt8] = builder.sb_new();
  builder.sb_push_str(&mut sb, "#");
  if code != 0 {
    builder.sb_push_byte(&mut sb, code as UInt8);
  }
  return builder.sb_to_str(&sb);
}
