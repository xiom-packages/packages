/// Per-group entry counts (DLSS_GROUP_*).  The suite cross-checks the
/// table against these pins.
/// Complexity: O(1).
pub fn dlss_group_entry_count(group: Int) -> Int
  requires: group >= 0
  requires: group <= 5
{
  if group == 0 { return 15; }
  if group == 1 { return 15; }
  if group == 2 { return 17; }
  if group == 3 { return 20; }
  if group == 4 { return 16; }
  if group == 5 { return 2; }
  return 0;
}

