# BLAS/LAPACK FFI Bindings — Linear Algebra
# Target: libopenblas.dll, libblas.dll, liblapack.dll

library "openblas" {
  fn cblas_dgemm(order: i32, transA: i32, transB: i32, m: i32, n: i32, k: i32, alpha: f64, A: ptr, lda: i32, B: ptr, ldb: i32, beta: f64, C: ptr, ldc: i32);
  fn cblas_sgemm(order: i32, transA: i32, transB: i32, m: i32, n: i32, k: i32, alpha: f32, A: ptr, lda: i32, B: ptr, ldb: i32, beta: f32, C: ptr, ldc: i32);
  fn cblas_dgemv(order: i32, trans: i32, m: i32, n: i32, alpha: f64, A: ptr, lda: i32, X: ptr, incX: i32, beta: f64, Y: ptr, incY: i32);
  fn cblas_ddot(N: i32, X: ptr, incX: i32, Y: ptr, incY: i32) -> f64;
  fn cblas_daxpy(N: i32, alpha: f64, X: ptr, incX: i32, Y: ptr, incY: i32);
  fn cblas_dscal(N: i32, alpha: f64, X: ptr, incX: i32);
}
