package xiom_box2d {
  name: "xiom.box2d"
  version: "0.2.0"
  description: "Box2D 2D physics bindings for XIOM (vendored v3.1.1 C sources, integer bridge)"
  categories: ["graphics"]
  keywords: ["box2d", "physics", "2d", "collision", "binding"]
  license: "MIT OR Apache-2.0"
  repository: "https://github.com/xiom-packages/packages"
  authors: ["XIOM Team"]
  deps: {
    "xiom.std": ">=0.60.0 <1.0.0"
  }
}
