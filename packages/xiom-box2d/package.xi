package {
  name: "xiom.box2d"
  version: "0.1.0"
  description: "Box2D 2D physics engine FFI bindings for XIOM"
  categories: ["graphics"]
  keywords: ["box2d", "physics", "2d", "collision"]
  license: "MIT OR Apache-2.0"
  repository: "https://github.com/xiom-packages/packages"
  authors: ["XIOM Team"]
  deps: {
    "xiom.std": "0.1.0"
  }
}
