package xiom_micro {
  name: "xiom.micro";
  version: "0.1.0";
  description: "Microservices resilience -- service discovery, typed RPC, retries/budgets, circuit breakers, bulkheads, tracing, sagas, built on xiom.http";
  categories: ["web", "cloud-infra"];
  keywords: ["microservices", "circuit-breaker", "retry", "discovery", "rpc"];
  license: "MIT OR Apache-2.0";
  repository: "https://github.com/xiom-packages/packages";
  authors: ["XIOM Team"];
  deps: { "xiom.std": "0.1.0", "xiom.http": "0.1.0" };
}
