package xiom_directx12 {
  name: "xiom.directx12";
  version: "0.2.0";
  description: "Direct3D 12 / DXGI capability probe for XIOM (runtime d3d12.dll + dxgi.dll, no SDK headers, SKIP when absent)";
  categories: ["graphics"];
  keywords: ["directx12", "d3d12", "gpu", "rendering", "windows", "binding"];
  license: "MIT OR Apache-2.0";
  repository: "https://github.com/xiom-packages/packages";
  authors: ["XIOM Team"];
  deps: { "xiom.std": ">=0.60.0 <1.0.0" };
}
