package xiom_directx12 {
  name: "xiom.directx12";
  version: "0.1.0";
  description: "Direct3D 12 bindings for Microsoft's low-level explicit-GPU-control graphics API";
  categories: ["graphics"];
  keywords: ["directx12", "d3d12", "gpu", "rendering", "windows"];
  license: "MIT OR Apache-2.0";
  repository: "https://github.com/xiom-packages/packages";
  authors: ["XIOM Team"];
  deps: { "xiom.std": "0.1.0" };
}
