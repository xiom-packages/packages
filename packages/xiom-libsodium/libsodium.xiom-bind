# libsodium FFI Bindings — Secure Cryptography
# Target: libsodium.dll (Windows), libsodium.so (Linux), libsodium.dylib (macOS)

library "libsodium" {
  fn sodium_init() -> i32;

  # Random
  fn randombytes_buf(buf: ptr, size: u64);
  fn randombytes_uniform(upper_bound: i32) -> i32;
  fn randombytes_random() -> i32;

  # Secret-key crypto
  fn crypto_secretbox_easy(ciphertext: ptr, message: ptr, message_len: u64, nonce: ptr, key: ptr) -> i32;
  fn crypto_secretbox_open_easy(message: ptr, ciphertext: ptr, ciphertext_len: u64, nonce: ptr, key: ptr) -> i32;

  # Public-key crypto
  fn crypto_box_keypair(public_key: ptr, secret_key: ptr) -> i32;
  fn crypto_box_easy(ciphertext: ptr, message: ptr, message_len: u64, nonce: ptr, receiver_pk: ptr, sender_sk: ptr) -> i32;
  fn crypto_box_open_easy(message: ptr, ciphertext: ptr, ciphertext_len: u64, nonce: ptr, sender_pk: ptr, receiver_sk: ptr) -> i32;

  # Signatures
  fn crypto_sign_keypair(public_key: ptr, secret_key: ptr) -> i32;
  fn crypto_sign_detached(signature: ptr, sig_len: ptr, message: ptr, message_len: u64, secret_key: ptr) -> i32;
  fn crypto_sign_verify_detached(signature: ptr, message: ptr, message_len: u64, public_key: ptr) -> i32;

  # Hashing
  fn crypto_generichash(output: ptr, output_len: u64, input: ptr, input_len: u64, key: ptr, key_len: u64) -> i32;

  # Password hashing
  fn crypto_pwhash(output: ptr, output_len: u64, password: str, password_len: u64, salt: ptr, opslimit: u64, memlimit: u64, alg: i32) -> i32;

  # Key derivation
  fn crypto_kdf_keygen(key: ptr);
  fn crypto_kdf_derive_from_key(subkey: ptr, subkey_len: u64, subkey_id: u64, ctx: str, master_key: ptr) -> i32;

  # Constants
  # crypto_secretbox_KEYBYTES
  # crypto_box_PUBLICKEYBYTES
  # crypto_box_SECRETKEYBYTES
  # crypto_sign_PUBLICKEYBYTES
  # crypto_sign_SECRETKEYBYTES
}
