package {
  name: "xiom.sdl3"
  version: "0.1.0"
  description: "SDL3 (Simple DirectMedia Layer 3) bindings for XIOM"
  categories: ["graphics", "media"]
  keywords: ["sdl3", "windowing", "input", "audio"]
  license: "MIT OR Apache-2.0"
  repository: "https://github.com/xiom-packages/packages"
  authors: ["XIOM Team"]
  deps: {
    "xiom.std": "0.1.0"
  }
}
