/// SDL_LoadBMP(const char *file) -> SDL_Surface *
/// Complexity: O(1).
pub fn sdl3full_load_bmp(lib: &Sdl3FullSurface, file: Str) -> Int
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_load_bmp as fn(*UInt8) -> Int;
    return f(file.c_str()) as Int;
  }
}

/// SDL_LoadBMP_IO(SDL_IOStream *src, bool closeio) -> SDL_Surface *
/// Complexity: O(1).
pub fn sdl3full_load_bmp_io(lib: &Sdl3FullSurface, src: Int, closeio: Bool) -> Int
  requires: lib.handle != 0
{
  unsafe {
    let v_closeio: UInt8 = if closeio { 1 as UInt8 } else { 0 as UInt8 };
    let f = lib.p_load_bmp_io as fn(Int, UInt8) -> Int;
    return f(src, v_closeio) as Int;
  }
}

