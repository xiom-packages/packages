  }
}

/// SDL_GetSurfaceColorMod(SDL_Surface *surface, Uint8 *r, Uint8 *g, Uint8 *b) -> bool
/// Complexity: O(1).
pub fn sdl3full_get_surface_color_mod(lib: &Sdl3FullSurface, surface: Int, r: Int, g: Int, b: Int) -> Bool
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_get_surface_color_mod as fn(Int, Int, Int, Int) -> UInt8;
    return (f(surface, r, g, b) as Int) != 0;
  }
}

