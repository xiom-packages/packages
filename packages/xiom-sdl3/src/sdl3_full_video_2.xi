pub fn sdl3full_get_window_surface_v_sync(lib: &Sdl3FullVideo2, window: Int, vsync: Int) -> Bool
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_get_window_surface_v_sync as fn(Int, Int) -> UInt8;
    return (f(window, vsync) as Int) != 0;
  }
}

/// SDL_GetWindowTitle(SDL_Window *window) -> const char *
/// Complexity: O(1).
pub fn sdl3full_get_window_title(lib: &Sdl3FullVideo2, window: Int) -> Str
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_get_window_title as fn(Int) -> *UInt8;
    let p_ret = f(window);
    if (p_ret as Int) == 0 { return ""; }
    return Str::from_c_str(p_ret);
  }
}

