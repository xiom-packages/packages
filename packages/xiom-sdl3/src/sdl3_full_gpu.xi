  p_end_gpu_copy_pass: Int;
  p_end_gpu_render_pass: Int;
  p_gdk_resume_gpu: Int;
  p_gdk_suspend_gpu: Int;
  p_gpu_supports_properties: Int;
  p_gpu_supports_shader_formats: Int;
}

/// Resolve every symbol in this family from an already-open SDL3
/// library; Err carries the first missing symbol name.
/// Complexity: O(symbols).
pub fn sdl3full_module_load_gpu(soname: Str) -> Result[Sdl3FullGpu, Str] {
  let h = dl.dl_open(soname);
  if !h.is_ok { return Err(h.error); }
  let handle: Int = h.value;
  let a1 = dl.dl_sym(handle, "SDL_AcquireGPUCommandBuffer");
  if !a1.is_ok { var ig = dl.dl_close(handle); return Err("SDL_AcquireGPUCommandBuffer: " + a1.error); }
  let a2 = dl.dl_sym(handle, "SDL_AcquireGPUSwapchainTexture");
  if !a2.is_ok { var ig = dl.dl_close(handle); return Err("SDL_AcquireGPUSwapchainTexture: " + a2.error); }
  let a3 = dl.dl_sym(handle, "SDL_BeginGPUComputePass");
  if !a3.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BeginGPUComputePass: " + a3.error); }
  let a4 = dl.dl_sym(handle, "SDL_BeginGPUCopyPass");
  if !a4.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BeginGPUCopyPass: " + a4.error); }
  let a5 = dl.dl_sym(handle, "SDL_BeginGPURenderPass");
  if !a5.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BeginGPURenderPass: " + a5.error); }
  let a6 = dl.dl_sym(handle, "SDL_BindGPUComputePipeline");
  if !a6.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BindGPUComputePipeline: " + a6.error); }
  let a7 = dl.dl_sym(handle, "SDL_BindGPUComputeSamplers");
  if !a7.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BindGPUComputeSamplers: " + a7.error); }
  let a8 = dl.dl_sym(handle, "SDL_BindGPUComputeStorageBuffers");
  if !a8.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BindGPUComputeStorageBuffers: " + a8.error); }
  let a9 = dl.dl_sym(handle, "SDL_BindGPUComputeStorageTextures");
  if !a9.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BindGPUComputeStorageTextures: " + a9.error); }
  let a10 = dl.dl_sym(handle, "SDL_BindGPUFragmentSamplers");
  if !a10.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BindGPUFragmentSamplers: " + a10.error); }
  let a11 = dl.dl_sym(handle, "SDL_BindGPUFragmentStorageBuffers");
  if !a11.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BindGPUFragmentStorageBuffers: " + a11.error); }
  let a12 = dl.dl_sym(handle, "SDL_BindGPUFragmentStorageTextures");
  if !a12.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BindGPUFragmentStorageTextures: " + a12.error); }
  let a13 = dl.dl_sym(handle, "SDL_BindGPUGraphicsPipeline");
  if !a13.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BindGPUGraphicsPipeline: " + a13.error); }
  let a14 = dl.dl_sym(handle, "SDL_BindGPUIndexBuffer");
  if !a14.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BindGPUIndexBuffer: " + a14.error); }
  let a15 = dl.dl_sym(handle, "SDL_BindGPUVertexBuffers");
  if !a15.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BindGPUVertexBuffers: " + a15.error); }
  let a16 = dl.dl_sym(handle, "SDL_BindGPUVertexSamplers");
  if !a16.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BindGPUVertexSamplers: " + a16.error); }
  let a17 = dl.dl_sym(handle, "SDL_BindGPUVertexStorageBuffers");
  if !a17.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BindGPUVertexStorageBuffers: " + a17.error); }
  let a18 = dl.dl_sym(handle, "SDL_BindGPUVertexStorageTextures");
  if !a18.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BindGPUVertexStorageTextures: " + a18.error); }
  let a19 = dl.dl_sym(handle, "SDL_BlitGPUTexture");
  if !a19.is_ok { var ig = dl.dl_close(handle); return Err("SDL_BlitGPUTexture: " + a19.error); }
  let a20 = dl.dl_sym(handle, "SDL_CalculateGPUTextureFormatSize");
  if !a20.is_ok { var ig = dl.dl_close(handle); return Err("SDL_CalculateGPUTextureFormatSize: " + a20.error); }
  let a21 = dl.dl_sym(handle, "SDL_CancelGPUCommandBuffer");
  if !a21.is_ok { var ig = dl.dl_close(handle); return Err("SDL_CancelGPUCommandBuffer: " + a21.error); }
  let a22 = dl.dl_sym(handle, "SDL_ClaimWindowForGPUDevice");
  if !a22.is_ok { var ig = dl.dl_close(handle); return Err("SDL_ClaimWindowForGPUDevice: " + a22.error); }
  let a23 = dl.dl_sym(handle, "SDL_CopyGPUBufferToBuffer");
  if !a23.is_ok { var ig = dl.dl_close(handle); return Err("SDL_CopyGPUBufferToBuffer: " + a23.error); }
  let a24 = dl.dl_sym(handle, "SDL_CopyGPUTextureToTexture");
  if !a24.is_ok { var ig = dl.dl_close(handle); return Err("SDL_CopyGPUTextureToTexture: " + a24.error); }
  let a25 = dl.dl_sym(handle, "SDL_CreateGPUBuffer");
  if !a25.is_ok { var ig = dl.dl_close(handle); return Err("SDL_CreateGPUBuffer: " + a25.error); }
  let a26 = dl.dl_sym(handle, "SDL_CreateGPUComputePipeline");
  if !a26.is_ok { var ig = dl.dl_close(handle); return Err("SDL_CreateGPUComputePipeline: " + a26.error); }
  let a27 = dl.dl_sym(handle, "SDL_CreateGPUDevice");
  if !a27.is_ok { var ig = dl.dl_close(handle); return Err("SDL_CreateGPUDevice: " + a27.error); }
  let a28 = dl.dl_sym(handle, "SDL_CreateGPUDeviceWithProperties");
  if !a28.is_ok { var ig = dl.dl_close(handle); return Err("SDL_CreateGPUDeviceWithProperties: " + a28.error); }
  let a29 = dl.dl_sym(handle, "SDL_CreateGPUGraphicsPipeline");
  if !a29.is_ok { var ig = dl.dl_close(handle); return Err("SDL_CreateGPUGraphicsPipeline: " + a29.error); }
  let a30 = dl.dl_sym(handle, "SDL_CreateGPUSampler");
  if !a30.is_ok { var ig = dl.dl_close(handle); return Err("SDL_CreateGPUSampler: " + a30.error); }
  let a31 = dl.dl_sym(handle, "SDL_CreateGPUShader");
  if !a31.is_ok { var ig = dl.dl_close(handle); return Err("SDL_CreateGPUShader: " + a31.error); }
  let a32 = dl.dl_sym(handle, "SDL_CreateGPUTexture");
  if !a32.is_ok { var ig = dl.dl_close(handle); return Err("SDL_CreateGPUTexture: " + a32.error); }
  let a33 = dl.dl_sym(handle, "SDL_CreateGPUTransferBuffer");
  if !a33.is_ok { var ig = dl.dl_close(handle); return Err("SDL_CreateGPUTransferBuffer: " + a33.error); }
  let a34 = dl.dl_sym(handle, "SDL_DestroyGPUDevice");
  if !a34.is_ok { var ig = dl.dl_close(handle); return Err("SDL_DestroyGPUDevice: " + a34.error); }
  let a35 = dl.dl_sym(handle, "SDL_DispatchGPUCompute");
  if !a35.is_ok { var ig = dl.dl_close(handle); return Err("SDL_DispatchGPUCompute: " + a35.error); }
  let a36 = dl.dl_sym(handle, "SDL_DispatchGPUComputeIndirect");
  if !a36.is_ok { var ig = dl.dl_close(handle); return Err("SDL_DispatchGPUComputeIndirect: " + a36.error); }
  let a37 = dl.dl_sym(handle, "SDL_DownloadFromGPUBuffer");
  if !a37.is_ok { var ig = dl.dl_close(handle); return Err("SDL_DownloadFromGPUBuffer: " + a37.error); }
  let a38 = dl.dl_sym(handle, "SDL_DownloadFromGPUTexture");
  if !a38.is_ok { var ig = dl.dl_close(handle); return Err("SDL_DownloadFromGPUTexture: " + a38.error); }
  let a39 = dl.dl_sym(handle, "SDL_DrawGPUIndexedPrimitives");
  if !a39.is_ok { var ig = dl.dl_close(handle); return Err("SDL_DrawGPUIndexedPrimitives: " + a39.error); }
  let a40 = dl.dl_sym(handle, "SDL_DrawGPUIndexedPrimitivesIndirect");
  if !a40.is_ok { var ig = dl.dl_close(handle); return Err("SDL_DrawGPUIndexedPrimitivesIndirect: " + a40.error); }
  let a41 = dl.dl_sym(handle, "SDL_DrawGPUPrimitives");
  if !a41.is_ok { var ig = dl.dl_close(handle); return Err("SDL_DrawGPUPrimitives: " + a41.error); }
  let a42 = dl.dl_sym(handle, "SDL_DrawGPUPrimitivesIndirect");
  if !a42.is_ok { var ig = dl.dl_close(handle); return Err("SDL_DrawGPUPrimitivesIndirect: " + a42.error); }
  let a43 = dl.dl_sym(handle, "SDL_EndGPUComputePass");
  if !a43.is_ok { var ig = dl.dl_close(handle); return Err("SDL_EndGPUComputePass: " + a43.error); }
  let a44 = dl.dl_sym(handle, "SDL_EndGPUCopyPass");
  if !a44.is_ok { var ig = dl.dl_close(handle); return Err("SDL_EndGPUCopyPass: " + a44.error); }
  let a45 = dl.dl_sym(handle, "SDL_EndGPURenderPass");
  if !a45.is_ok { var ig = dl.dl_close(handle); return Err("SDL_EndGPURenderPass: " + a45.error); }
  let a46 = dl.dl_sym(handle, "SDL_GDKResumeGPU");
  if !a46.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GDKResumeGPU: " + a46.error); }
  let a47 = dl.dl_sym(handle, "SDL_GDKSuspendGPU");
  if !a47.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GDKSuspendGPU: " + a47.error); }
  let a48 = dl.dl_sym(handle, "SDL_GPUSupportsProperties");
  if !a48.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GPUSupportsProperties: " + a48.error); }
  let a49 = dl.dl_sym(handle, "SDL_GPUSupportsShaderFormats");
  if !a49.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GPUSupportsShaderFormats: " + a49.error); }
  return Ok(Sdl3FullGpu{
    handle: handle,
    p_acquire_gpu_command_buffer: a1.value,
    p_acquire_gpu_swapchain_texture: a2.value,
    p_begin_gpu_compute_pass: a3.value,
    p_begin_gpu_copy_pass: a4.value,
    p_begin_gpu_render_pass: a5.value,
    p_bind_gpu_compute_pipeline: a6.value,
    p_bind_gpu_compute_samplers: a7.value,
    p_bind_gpu_compute_storage_buffers: a8.value,
    p_bind_gpu_compute_storage_textures: a9.value,
    p_bind_gpu_fragment_samplers: a10.value,
    p_bind_gpu_fragment_storage_buffers: a11.value,
    p_bind_gpu_fragment_storage_textures: a12.value,
    p_bind_gpu_graphics_pipeline: a13.value,
    p_bind_gpu_index_buffer: a14.value,
    p_bind_gpu_vertex_buffers: a15.value,
    p_bind_gpu_vertex_samplers: a16.value,
    p_bind_gpu_vertex_storage_buffers: a17.value,
    p_bind_gpu_vertex_storage_textures: a18.value,
    p_blit_gpu_texture: a19.value,
    p_calculate_gpu_texture_format_size: a20.value,
    p_cancel_gpu_command_buffer: a21.value,
    p_claim_window_for_gpu_device: a22.value,
    p_copy_gpu_buffer_to_buffer: a23.value,
    p_copy_gpu_texture_to_texture: a24.value,
    p_create_gpu_buffer: a25.value,
    p_create_gpu_compute_pipeline: a26.value,
    p_create_gpu_device: a27.value,
    p_create_gpu_device_with_properties: a28.value,
    p_create_gpu_graphics_pipeline: a29.value,
    p_create_gpu_sampler: a30.value,
    p_create_gpu_shader: a31.value,
    p_create_gpu_texture: a32.value,
    p_create_gpu_transfer_buffer: a33.value,
    p_destroy_gpu_device: a34.value,
    p_dispatch_gpu_compute: a35.value,
    p_dispatch_gpu_compute_indirect: a36.value,
    p_download_from_gpu_buffer: a37.value,
    p_download_from_gpu_texture: a38.value,
    p_draw_gpu_indexed_primitives: a39.value,
    p_draw_gpu_indexed_primitives_indirect: a40.value,
    p_draw_gpu_primitives: a41.value,
    p_draw_gpu_primitives_indirect: a42.value,
    p_end_gpu_compute_pass: a43.value,
    p_end_gpu_copy_pass: a44.value,
    p_end_gpu_render_pass: a45.value,
    p_gdk_resume_gpu: a46.value,
    p_gdk_suspend_gpu: a47.value,
    p_gpu_supports_properties: a48.value,
    p_gpu_supports_shader_formats: a49.value,
  });
}

/// Release the loader handle.
/// Complexity: O(1).
pub fn sdl3full_module_close_gpu(lib: &Sdl3FullGpu) -> Result[Unit, Str]
  requires: lib.handle != 0
{
  return dl.dl_close(lib.handle);
}

/// SDL_AcquireGPUCommandBuffer(SDL_GPUDevice *device) -> SDL_GPUCommandBuffer *
/// Complexity: O(1).
pub fn sdl3full_acquire_gpu_command_buffer(lib: &Sdl3FullGpu, device: Int) -> Int
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_acquire_gpu_command_buffer as fn(Int) -> Int;
    return f(device) as Int;
  }
}

/// SDL_AcquireGPUSwapchainTexture(SDL_GPUCommandBuffer *command_buffer, SDL_Window *window, SDL_GPUTexture **swapchain_texture, Uint32 *swapchain_text...
/// Complexity: O(1).
pub fn sdl3full_acquire_gpu_swapchain_texture(lib: &Sdl3FullGpu, command_buffer: Int, window: Int, swapchain_texture: Int, swapchain_texture_width: Int, swapchain_texture_height: Int) -> Bool
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_acquire_gpu_swapchain_texture as fn(Int, Int, Int, Int, Int) -> UInt8;
    return (f(command_buffer, window, swapchain_texture, swapchain_texture_width, swapchain_texture_height) as Int) != 0;
  }
}

