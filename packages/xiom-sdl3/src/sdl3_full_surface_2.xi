  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_write_surface_pixel as fn(Int, Int, Int, Int, Int, Int, Int) -> UInt8;
    return (f(surface, x, y, r, g, b, a) as Int) != 0;
  }
}

/// SDL_WriteSurfacePixelFloat(SDL_Surface *surface, int x, int y, float r, float g, float b, float a) -> bool
/// Complexity: O(1).
pub fn sdl3full_write_surface_pixel_float(lib: &Sdl3FullSurface2, surface: Int, x: Int, y: Int, r: Float64, g: Float64, b: Float64, a: Float64) -> Bool
  requires: lib.handle != 0
{
  unsafe {
    let v_r: Float32 = r as Float32;
    let v_g: Float32 = g as Float32;
    let v_b: Float32 = b as Float32;
    let v_a: Float32 = a as Float32;
    let f = lib.p_write_surface_pixel_float as fn(Int, Int, Int, Float32, Float32, Float32, Float32) -> UInt8;
    return (f(surface, x, y, v_r, v_g, v_b, v_a) as Int) != 0;
  }
}

