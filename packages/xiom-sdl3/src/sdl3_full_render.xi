}

/// SDL_GetTextureSize(SDL_Texture *texture, float *w, float *h) -> bool
/// Complexity: O(1).
pub fn sdl3full_get_texture_size(lib: &Sdl3FullRender, texture: Int, w: Int, h: Int) -> Bool
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_get_texture_size as fn(Int, Int, Int) -> UInt8;
    return (f(texture, w, h) as Int) != 0;
  }
}

/// SDL_LockTexture(SDL_Texture *texture, const SDL_Rect *rect, void **pixels, int *pitch) -> bool
/// Complexity: O(1).
pub fn sdl3full_lock_texture(lib: &Sdl3FullRender, texture: Int, rect: Int, pixels: Int, pitch: Int) -> Bool
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_lock_texture as fn(Int, Int, Int, Int) -> UInt8;
    return (f(texture, rect, pixels, pitch) as Int) != 0;
  }
}

