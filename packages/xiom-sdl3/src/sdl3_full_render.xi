  return Ok(Sdl3FullRender{
    handle: handle,
    p_add_vulkan_render_semaphores: a1.value,
    p_convert_event_to_render_coordinates: a2.value,
    p_create_gpu_render_state: a3.value,
    p_create_gpu_renderer: a4.value,
    p_create_renderer: a5.value,
    p_create_renderer_with_properties: a6.value,
    p_create_software_renderer: a7.value,
    p_create_texture: a8.value,
    p_create_texture_from_surface: a9.value,
    p_create_texture_with_properties: a10.value,
    p_create_window_and_renderer: a11.value,
    p_destroy_gpu_render_state: a12.value,
    p_destroy_renderer: a13.value,
    p_destroy_texture: a14.value,
    p_flush_renderer: a15.value,
    p_get_current_render_output_size: a16.value,
    p_get_default_texture_scale_mode: a17.value,
    p_get_gpu_renderer_device: a18.value,
    p_get_num_render_drivers: a19.value,
    p_get_render_clip_rect: a20.value,
    p_get_render_color_scale: a21.value,
    p_get_render_draw_blend_mode: a22.value,
    p_get_render_draw_color: a23.value,
    p_get_render_draw_color_float: a24.value,
    p_get_render_driver: a25.value,
    p_get_render_logical_presentation: a26.value,
    p_get_render_logical_presentation_rect: a27.value,
    p_get_render_metal_command_encoder: a28.value,
    p_get_render_metal_layer: a29.value,
    p_get_render_output_size: a30.value,
    p_get_render_safe_area: a31.value,
    p_get_render_scale: a32.value,
    p_get_render_target: a33.value,
    p_get_render_texture_address_mode: a34.value,
    p_get_render_v_sync: a35.value,
    p_get_render_viewport: a36.value,
    p_get_render_window: a37.value,
    p_get_renderer: a38.value,
    p_get_renderer_from_texture: a39.value,
    p_get_renderer_name: a40.value,
    p_get_renderer_properties: a41.value,
    p_get_texture_alpha_mod: a42.value,
    p_get_texture_alpha_mod_float: a43.value,
    p_get_texture_blend_mode: a44.value,
    p_get_texture_color_mod: a45.value,
    p_get_texture_color_mod_float: a46.value,
    p_get_texture_palette: a47.value,
    p_get_texture_properties: a48.value,
    p_get_texture_scale_mode: a49.value,
    p_get_texture_size: a50.value,
    p_lock_texture: a51.value,
  });
}

/// Release the loader handle.
/// Complexity: O(1).
pub fn sdl3full_module_close_render(lib: &Sdl3FullRender) -> Result[Unit, Str]
  requires: lib.handle != 0
{
  return dl.dl_close(lib.handle);
}

