  let a7 = dl.dl_sym(handle, "SDL_GetRGB");
  if !a7.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetRGB: " + a7.error); }
  let a8 = dl.dl_sym(handle, "SDL_GetRGBA");
  if !a8.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetRGBA: " + a8.error); }
  let a9 = dl.dl_sym(handle, "SDL_MapRGB");
  if !a9.is_ok { var ig = dl.dl_close(handle); return Err("SDL_MapRGB: " + a9.error); }
  let a10 = dl.dl_sym(handle, "SDL_MapRGBA");
  if !a10.is_ok { var ig = dl.dl_close(handle); return Err("SDL_MapRGBA: " + a10.error); }
