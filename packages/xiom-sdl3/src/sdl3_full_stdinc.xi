/// SDL_getenv(const char *name) -> const char *
/// Complexity: O(1).
pub fn sdl3full_getenv(lib: &Sdl3FullStdinc, name: Str) -> Str
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_getenv as fn(*UInt8) -> *UInt8;
    let p_ret = f(name.c_str());
