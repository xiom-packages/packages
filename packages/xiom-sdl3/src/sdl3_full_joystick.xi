/// Release the loader handle.
/// Complexity: O(1).
pub fn sdl3full_module_close_joystick(lib: &Sdl3FullJoystick) -> Result[Unit, Str]
  requires: lib.handle != 0
{
  return dl.dl_close(lib.handle);
}

/// SDL_AttachVirtualJoystick(const SDL_VirtualJoystickDesc *desc) -> SDL_JoystickID
/// Complexity: O(1).
pub fn sdl3full_attach_virtual_joystick(lib: &Sdl3FullJoystick, desc: Int) -> Int
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_attach_virtual_joystick as fn(Int) -> UInt32;
    return f(desc) as Int;
  }
}

/// SDL_CloseJoystick(SDL_Joystick *joystick) -> void
/// Complexity: O(1).
pub fn sdl3full_close_joystick(lib: &Sdl3FullJoystick, joystick: Int)
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_close_joystick as fn(Int);
    f(joystick);
  }
}

/// SDL_DetachVirtualJoystick(SDL_JoystickID instance_id) -> bool
/// Complexity: O(1).
pub fn sdl3full_detach_virtual_joystick(lib: &Sdl3FullJoystick, instance_id: Int) -> Bool
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_detach_virtual_joystick as fn(Int) -> UInt8;
    return (f(instance_id) as Int) != 0;
  }
}

/// SDL_GetJoystickAxis(SDL_Joystick *joystick, int axis) -> Sint16
/// Complexity: O(1).
pub fn sdl3full_get_joystick_axis(lib: &Sdl3FullJoystick, joystick: Int, axis: Int) -> Int
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_get_joystick_axis as fn(Int, Int) -> Int32;
    let raw_ret = (f(joystick, axis) as Int) & 0xffff;
    if raw_ret >= 32768 { return raw_ret - 65536; }
    return raw_ret;
  }
}

