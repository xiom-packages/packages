/// SDL_GetJoystickName(SDL_Joystick *joystick) -> const char *
/// Complexity: O(1).
pub fn sdl3full_get_joystick_name(lib: &Sdl3FullJoystick, joystick: Int) -> Str
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_get_joystick_name as fn(Int) -> *UInt8;
