/// SDL_GetJoystickGUID(SDL_Joystick *joystick) -> SDL_GUID
/// sret shape: `out` is a caller-owned buffer address (Win64 hidden
/// first argument for struct returns); true when SDL returned it.
/// Complexity: O(1).
pub fn sdl3full_get_joystick_guid(lib: &Sdl3FullJoystick, out: Int, joystick: Int) -> Bool
  requires: lib.handle != 0
  requires: out != 0
{
  unsafe {
    let f = lib.p_get_joystick_guid as fn(Int, Int) -> Int;
    return f(out, joystick) != 0;
  }
}

