/// SDL_GetVideoDriver(int index) -> const char *
/// Complexity: O(1).
pub fn sdl3full_get_video_driver(lib: &Sdl3FullVideo, index: Int) -> Str
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_get_video_driver as fn(Int) -> *UInt8;
    let p_ret = f(index);
    if (p_ret as Int) == 0 { return ""; }
    return Str::from_c_str(p_ret);
  }
}

