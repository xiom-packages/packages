  let a36 = dl.dl_sym(handle, "SDL_GetDisplayForPoint");
  if !a36.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetDisplayForPoint: " + a36.error); }
  let a37 = dl.dl_sym(handle, "SDL_GetDisplayForRect");
  if !a37.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetDisplayForRect: " + a37.error); }
  let a38 = dl.dl_sym(handle, "SDL_GetDisplayForWindow");
  if !a38.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetDisplayForWindow: " + a38.error); }
  let a39 = dl.dl_sym(handle, "SDL_GetDisplayName");
  if !a39.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetDisplayName: " + a39.error); }
  let a40 = dl.dl_sym(handle, "SDL_GetDisplayProperties");
  if !a40.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetDisplayProperties: " + a40.error); }
  let a41 = dl.dl_sym(handle, "SDL_GetDisplayUsableBounds");
  if !a41.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetDisplayUsableBounds: " + a41.error); }
  let a42 = dl.dl_sym(handle, "SDL_GetDisplays");
  if !a42.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetDisplays: " + a42.error); }
  let a43 = dl.dl_sym(handle, "SDL_GetFullscreenDisplayModes");
  if !a43.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetFullscreenDisplayModes: " + a43.error); }
  let a44 = dl.dl_sym(handle, "SDL_GetGrabbedWindow");
  if !a44.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetGrabbedWindow: " + a44.error); }
  let a45 = dl.dl_sym(handle, "SDL_GetNaturalDisplayOrientation");
  if !a45.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetNaturalDisplayOrientation: " + a45.error); }
  let a46 = dl.dl_sym(handle, "SDL_GetNumVideoDrivers");
  if !a46.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetNumVideoDrivers: " + a46.error); }
  let a47 = dl.dl_sym(handle, "SDL_GetPrimaryDisplay");
  if !a47.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetPrimaryDisplay: " + a47.error); }
  let a48 = dl.dl_sym(handle, "SDL_GetSystemTheme");
  if !a48.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetSystemTheme: " + a48.error); }
  let a49 = dl.dl_sym(handle, "SDL_GetVideoDriver");
  if !a49.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetVideoDriver: " + a49.error); }
  let a50 = dl.dl_sym(handle, "SDL_GetWindowAspectRatio");
  if !a50.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetWindowAspectRatio: " + a50.error); }
  let a51 = dl.dl_sym(handle, "SDL_GetWindowBordersSize");
  if !a51.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetWindowBordersSize: " + a51.error); }
  let a52 = dl.dl_sym(handle, "SDL_GetWindowDisplayScale");
  if !a52.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetWindowDisplayScale: " + a52.error); }
  let a53 = dl.dl_sym(handle, "SDL_GetWindowFlags");
  if !a53.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetWindowFlags: " + a53.error); }
  let a54 = dl.dl_sym(handle, "SDL_GetWindowFromID");
  if !a54.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetWindowFromID: " + a54.error); }
  let a55 = dl.dl_sym(handle, "SDL_GetWindowFullscreenMode");
  if !a55.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetWindowFullscreenMode: " + a55.error); }
  let a56 = dl.dl_sym(handle, "SDL_GetWindowICCProfile");
  if !a56.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetWindowICCProfile: " + a56.error); }
  let a57 = dl.dl_sym(handle, "SDL_GetWindowID");
  if !a57.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetWindowID: " + a57.error); }
  return Ok(Sdl3FullVideo{
    handle: handle,
    p_create_popup_window: a1.value,
    p_create_window: a2.value,
    p_create_window_with_properties: a3.value,
    p_destroy_window: a4.value,
    p_destroy_window_surface: a5.value,
    p_disable_screen_saver: a6.value,
    p_egl_get_current_config: a7.value,
    p_egl_get_current_display: a8.value,
    p_egl_get_proc_address: a9.value,
    p_egl_get_window_surface: a10.value,
    p_egl_set_attribute_callbacks: a11.value,
    p_enable_screen_saver: a12.value,
    p_flash_window: a13.value,
    p_gl_create_context: a14.value,
    p_gl_destroy_context: a15.value,
    p_gl_extension_supported: a16.value,
    p_gl_get_attribute: a17.value,
    p_gl_get_current_context: a18.value,
    p_gl_get_current_window: a19.value,
    p_gl_get_proc_address: a20.value,
    p_gl_get_swap_interval: a21.value,
    p_gl_load_library: a22.value,
    p_gl_make_current: a23.value,
    p_gl_reset_attributes: a24.value,
    p_gl_set_attribute: a25.value,
    p_gl_set_swap_interval: a26.value,
    p_gl_swap_window: a27.value,
    p_gl_unload_library: a28.value,
    p_get_closest_fullscreen_display_mode: a29.value,
    p_get_current_display_mode: a30.value,
    p_get_current_display_orientation: a31.value,
    p_get_current_video_driver: a32.value,
    p_get_desktop_display_mode: a33.value,
    p_get_display_bounds: a34.value,
    p_get_display_content_scale: a35.value,
    p_get_display_for_point: a36.value,
    p_get_display_for_rect: a37.value,
    p_get_display_for_window: a38.value,
    p_get_display_name: a39.value,
    p_get_display_properties: a40.value,
    p_get_display_usable_bounds: a41.value,
    p_get_displays: a42.value,
    p_get_fullscreen_display_modes: a43.value,
    p_get_grabbed_window: a44.value,
    p_get_natural_display_orientation: a45.value,
    p_get_num_video_drivers: a46.value,
    p_get_primary_display: a47.value,
    p_get_system_theme: a48.value,
    p_get_video_driver: a49.value,
    p_get_window_aspect_ratio: a50.value,
    p_get_window_borders_size: a51.value,
    p_get_window_display_scale: a52.value,
    p_get_window_flags: a53.value,
    p_get_window_from_id: a54.value,
    p_get_window_fullscreen_mode: a55.value,
    p_get_window_icc_profile: a56.value,
    p_get_window_id: a57.value,
  });
}

/// Release the loader handle.
/// Complexity: O(1).
pub fn sdl3full_module_close_video(lib: &Sdl3FullVideo) -> Result[Unit, Str]
  requires: lib.handle != 0
{
  return dl.dl_close(lib.handle);
}

