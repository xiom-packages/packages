/// SDL_GetClosestFullscreenDisplayMode(SDL_DisplayID displayID, int w, int h, float refresh_rate, bool include_high_density_modes, SDL_DisplayMode *cl...
/// Complexity: O(1).
pub fn sdl3full_get_closest_fullscreen_display_mode(lib: &Sdl3FullVideo, displayID: Int, w: Int, h: Int, refresh_rate: Float64, include_high_density_modes: Bool, closest: Int) -> Bool
  requires: lib.handle != 0
{
  unsafe {
    let v_refresh_rate: Float32 = refresh_rate as Float32;
    let v_include_high_density_modes: UInt8 = if include_high_density_modes { 1 as UInt8 } else { 0 as UInt8 };
    let f = lib.p_get_closest_fullscreen_display_mode as fn(Int, Int, Int, Float32, UInt8, Int) -> UInt8;
    return (f(displayID, w, h, v_refresh_rate, v_include_high_density_modes, closest) as Int) != 0;
  }
}

