/// B-12 caveat: fp cast-call returns are miscompiled on the pinned
/// toolchain -- the returned Float64 is NOT trustworthy.
/// Complexity: O(1).
pub fn sdl3full_modff(lib: &Sdl3FullStdinc2, x: Float64, y: Int) -> Float64
  requires: lib.handle != 0
{
  unsafe {
    let v_x: Float32 = x as Float32;
    let f = lib.p_modff as fn(Float32, Int) -> Float32;
    return f(v_x, y) as Float64;
  }
}

