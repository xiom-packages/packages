/// Complexity: O(1).
pub fn sdl3full_itoa(lib: &Sdl3FullStdinc2, value: Int, str: Int, radix: Int) -> Str
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_itoa as fn(Int, Int, Int) -> *UInt8;
    let p_ret = f(value, str, radix);
    if (p_ret as Int) == 0 { return ""; }
    return Str::from_c_str(p_ret);
  }
}

