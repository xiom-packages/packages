/// SDL_modf(double x, double *y) -> double
/// B-12 caveat: fp cast-call returns are miscompiled on the pinned
/// toolchain -- the returned Float64 is NOT trustworthy.
/// Complexity: O(1).
pub fn sdl3full_modf(lib: &Sdl3FullStdinc2, x: Float64, y: Int) -> Float64
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_modf as fn(Float64, Int) -> Float64;
    return f(x, y) as Float64;
  }
}

