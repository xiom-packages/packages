pub fn sdl3full_memcmp(lib: &Sdl3FullStdinc2, s1: Int, s2: Int, len: Int) -> Int
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_memcmp as fn(Int, Int, Int) -> Int32;
    return f(s1, s2, len) as Int;
  }
}

