/// SDL_GetGamepadConnectionState(SDL_Gamepad *gamepad) -> SDL_JoystickConnectionState
/// Complexity: O(1).
pub fn sdl3full_get_gamepad_connection_state(lib: &Sdl3FullGamepad, gamepad: Int) -> Int
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_get_gamepad_connection_state as fn(Int) -> UInt32;
    return f(gamepad) as Int;
  }
}

/// SDL_GetGamepadFirmwareVersion(SDL_Gamepad *gamepad) -> Uint16
/// Complexity: O(1).
pub fn sdl3full_get_gamepad_firmware_version(lib: &Sdl3FullGamepad, gamepad: Int) -> Int
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_get_gamepad_firmware_version as fn(Int) -> Int32;
    let raw_ret = (f(gamepad) as Int) & 0xffff;
    return raw_ret;
  }
}

