/// SDL_GetGamepadGUIDForID(SDL_JoystickID instance_id) -> SDL_GUID
/// sret shape: `out` is a caller-owned buffer address (Win64 hidden
/// first argument for struct returns); true when SDL returned it.
/// Complexity: O(1).
pub fn sdl3full_get_gamepad_guid_for_id(lib: &Sdl3FullGamepad, out: Int, instance_id: Int) -> Bool
  requires: lib.handle != 0
  requires: out != 0
{
  unsafe {
    let f = lib.p_get_gamepad_guid_for_id as fn(Int, Int) -> Int;
    return f(out, instance_id) != 0;
  }
}

