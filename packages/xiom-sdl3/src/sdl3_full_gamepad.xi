/// SDL_GetGamepadMapping(SDL_Gamepad *gamepad) -> char *
/// Complexity: O(1).
pub fn sdl3full_get_gamepad_mapping(lib: &Sdl3FullGamepad, gamepad: Int) -> Str
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_get_gamepad_mapping as fn(Int) -> *UInt8;
    let p_ret = f(gamepad);
    if (p_ret as Int) == 0 { return ""; }
    return Str::from_c_str(p_ret);
  }
}

