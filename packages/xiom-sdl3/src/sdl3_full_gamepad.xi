pub fn sdl3full_get_gamepad_button_from_string(lib: &Sdl3FullGamepad, str: Str) -> Int
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_get_gamepad_button_from_string as fn(*UInt8) -> UInt32;
    return f(str.c_str()) as Int;
  }
}

/// SDL_GetGamepadButtonLabel(SDL_Gamepad *gamepad, SDL_GamepadButton button) -> SDL_GamepadButtonLabel
/// Complexity: O(1).
pub fn sdl3full_get_gamepad_button_label(lib: &Sdl3FullGamepad, gamepad: Int, button: Int) -> Int
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_get_gamepad_button_label as fn(Int, Int) -> UInt32;
    return f(gamepad, button) as Int;
  }
}

/// SDL_GetGamepadButtonLabelForType(SDL_GamepadType type, SDL_GamepadButton button) -> SDL_GamepadButtonLabel
/// Complexity: O(1).
pub fn sdl3full_get_gamepad_button_label_for_type(lib: &Sdl3FullGamepad, v_type: Int, button: Int) -> Int
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_get_gamepad_button_label_for_type as fn(Int, Int) -> UInt32;
