/// Resolved symbols for this family (8 functions).
pub type Sdl3FullHints = {
  handle: Int;
  p_add_hint_callback: Int;
  p_get_hint: Int;
  p_get_hint_boolean: Int;
  p_remove_hint_callback: Int;
  p_reset_hint: Int;
  p_reset_hints: Int;
  p_set_hint: Int;
  p_set_hint_with_priority: Int;
}

/// Resolve every symbol in this family from an already-open SDL3
/// library; Err carries the first missing symbol name.
/// Complexity: O(symbols).
pub fn sdl3full_module_load_hints(soname: Str) -> Result[Sdl3FullHints, Str] {
  let h = dl.dl_open(soname);
  if !h.is_ok { return Err(h.error); }
  let handle: Int = h.value;
  let a1 = dl.dl_sym(handle, "SDL_AddHintCallback");
  if !a1.is_ok { var ig = dl.dl_close(handle); return Err("SDL_AddHintCallback: " + a1.error); }
  let a2 = dl.dl_sym(handle, "SDL_GetHint");
  if !a2.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetHint: " + a2.error); }
  let a3 = dl.dl_sym(handle, "SDL_GetHintBoolean");
  if !a3.is_ok { var ig = dl.dl_close(handle); return Err("SDL_GetHintBoolean: " + a3.error); }
  let a4 = dl.dl_sym(handle, "SDL_RemoveHintCallback");
  if !a4.is_ok { var ig = dl.dl_close(handle); return Err("SDL_RemoveHintCallback: " + a4.error); }
  let a5 = dl.dl_sym(handle, "SDL_ResetHint");
  if !a5.is_ok { var ig = dl.dl_close(handle); return Err("SDL_ResetHint: " + a5.error); }
  let a6 = dl.dl_sym(handle, "SDL_ResetHints");
  if !a6.is_ok { var ig = dl.dl_close(handle); return Err("SDL_ResetHints: " + a6.error); }
  let a7 = dl.dl_sym(handle, "SDL_SetHint");
  if !a7.is_ok { var ig = dl.dl_close(handle); return Err("SDL_SetHint: " + a7.error); }
  let a8 = dl.dl_sym(handle, "SDL_SetHintWithPriority");
  if !a8.is_ok { var ig = dl.dl_close(handle); return Err("SDL_SetHintWithPriority: " + a8.error); }
  return Ok(Sdl3FullHints{
    handle: handle,
    p_add_hint_callback: a1.value,
    p_get_hint: a2.value,
    p_get_hint_boolean: a3.value,
    p_remove_hint_callback: a4.value,
    p_reset_hint: a5.value,
    p_reset_hints: a6.value,
    p_set_hint: a7.value,
    p_set_hint_with_priority: a8.value,
  });
}

/// Release the loader handle.
/// Complexity: O(1).
pub fn sdl3full_module_close_hints(lib: &Sdl3FullHints) -> Result[Unit, Str]
  requires: lib.handle != 0
{
  return dl.dl_close(lib.handle);
}

/// SDL_AddHintCallback(const char *name, SDL_HintCallback callback, void *userdata) -> bool
/// Complexity: O(1).
pub fn sdl3full_add_hint_callback(lib: &Sdl3FullHints, name: Str, callback: Int, userdata: Int) -> Bool
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_add_hint_callback as fn(*UInt8, Int, Int) -> UInt8;
    return (f(name.c_str(), callback, userdata) as Int) != 0;
  }
}

/// SDL_GetHint(const char *name) -> const char *
/// Complexity: O(1).
pub fn sdl3full_get_hint(lib: &Sdl3FullHints, name: Str) -> Str
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_get_hint as fn(*UInt8) -> *UInt8;
    let p_ret = f(name.c_str());
    if (p_ret as Int) == 0 { return ""; }
    return Str::from_c_str(p_ret);
  }
}

/// SDL_GetHintBoolean(const char *name, bool default_value) -> bool
/// Complexity: O(1).
pub fn sdl3full_get_hint_boolean(lib: &Sdl3FullHints, name: Str, default_value: Bool) -> Bool
  requires: lib.handle != 0
{
  unsafe {
    let v_default_value: UInt8 = if default_value { 1 as UInt8 } else { 0 as UInt8 };
    let f = lib.p_get_hint_boolean as fn(*UInt8, UInt8) -> UInt8;
    return (f(name.c_str(), v_default_value) as Int) != 0;
  }
}

/// SDL_RemoveHintCallback(const char *name, SDL_HintCallback callback, void *userdata) -> void
/// Complexity: O(1).
pub fn sdl3full_remove_hint_callback(lib: &Sdl3FullHints, name: Str, callback: Int, userdata: Int)
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_remove_hint_callback as fn(*UInt8, Int, Int);
    f(name.c_str(), callback, userdata);
  }
}

/// SDL_ResetHint(const char *name) -> bool
/// Complexity: O(1).
pub fn sdl3full_reset_hint(lib: &Sdl3FullHints, name: Str) -> Bool
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_reset_hint as fn(*UInt8) -> UInt8;
    return (f(name.c_str()) as Int) != 0;
  }
}

/// SDL_ResetHints(void) -> void
/// Complexity: O(1).
pub fn sdl3full_reset_hints(lib: &Sdl3FullHints)
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_reset_hints as fn();
    f();
  }
}

/// SDL_SetHint(const char *name, const char *value) -> bool
/// Complexity: O(1).
pub fn sdl3full_set_hint(lib: &Sdl3FullHints, name: Str, value: Str) -> Bool
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_set_hint as fn(*UInt8, *UInt8) -> UInt8;
    return (f(name.c_str(), value.c_str()) as Int) != 0;
  }
}

/// SDL_SetHintWithPriority(const char *name, const char *value, SDL_HintPriority priority) -> bool
/// Complexity: O(1).
pub fn sdl3full_set_hint_with_priority(lib: &Sdl3FullHints, name: Str, value: Str, priority: Int) -> Bool
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_set_hint_with_priority as fn(*UInt8, *UInt8, Int) -> UInt8;
    return (f(name.c_str(), value.c_str(), priority) as Int) != 0;
  }
}

