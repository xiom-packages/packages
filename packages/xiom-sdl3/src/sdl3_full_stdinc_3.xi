}

/// SDL_strcasestr(const char *haystack, const char *needle) -> char *
/// Complexity: O(1).
pub fn sdl3full_strcasestr(lib: &Sdl3FullStdinc3, haystack: Str, needle: Str) -> Str
  requires: lib.handle != 0
{
  unsafe {
    let f = lib.p_strcasestr as fn(*UInt8, *UInt8) -> *UInt8;
    let p_ret = f(haystack.c_str(), needle.c_str());
    if (p_ret as Int) == 0 { return ""; }
    return Str::from_c_str(p_ret);
  }
}

