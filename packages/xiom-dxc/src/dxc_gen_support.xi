//
// Byte-level helpers for the generated wrappers. Every out-param is
// an XIOM-owned Vec[UInt8] slot; reads are byte-indexed little-endian
// (B-11..B-20 discipline -- no pointer arithmetic, no foreign reads).

module xiom.dxc.gen_support

/// An XIOM-owned zeroed byte slot (one slot per out-param).
pub fn dxc_slot(n: Int) -> Vec[UInt8]
  requires: n > 0
{
  var s: Vec[UInt8] = Vec[UInt8].new();
  var i = 0;
  while i < n {
    s.push(0 as UInt8);
    i = i + 1;
  }
  return s;
}

/// Little-endian u32 read from an XIOM-owned slot (byte-indexed).
pub fn dxc_rd_u32(buf: &Vec[UInt8]) -> Int
  requires: buf.len() >= 4
{
  let b0 = buf[0] as Int;
  let b1 = buf[1] as Int;
  let b2 = buf[2] as Int;
  let b3 = buf[3] as Int;
  return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

/// Little-endian u64 read from an XIOM-owned slot (byte-indexed).
pub fn dxc_rd_u64(buf: &Vec[UInt8]) -> Int
  requires: buf.len() >= 8
{
  var lo_slot = dxc_slot(4);
  lo_slot[0] = buf[0];
  lo_slot[1] = buf[1];
  lo_slot[2] = buf[2];
  lo_slot[3] = buf[3];
  let lo = dxc_rd_u32(&lo_slot);
  var hi_slot = dxc_slot(4);
  hi_slot[0] = buf[4];
  hi_slot[1] = buf[5];
  hi_slot[2] = buf[6];
  hi_slot[3] = buf[7];
  let hi = dxc_rd_u32(&hi_slot);
  return lo | (hi << 32);
}

/// UTF-8 bytes of a Str captured into an XIOM-owned Vec.
pub fn dxc_bytes(text: Str) -> Vec[UInt8]
  requires: text.len() > 0
{
  var v: Vec[UInt8] = Vec[UInt8].new();
  var i = 0;
  while i < text.len() {
    v.push(text.byte_at(i));
    i = i + 1;
  }
  return v;
}

pub fn dxc_i2s(n: Int) -> Str
  requires: n >= 0
{
  if n == 0 { return "0"; }
  var num = n;
  var out = "";
  while num > 0 {
    let d = num % 10;
    var ds = "0";
    if d == 1 { ds = "1"; }
    elif d == 2 { ds = "2"; }
    elif d == 3 { ds = "3"; }
    elif d == 4 { ds = "4"; }
    elif d == 5 { ds = "5"; }
    elif d == 6 { ds = "6"; }
    elif d == 7 { ds = "7"; }
    elif d == 8 { ds = "8"; }
    elif d == 9 { ds = "9"; }
    out = ds + out;
    num = num / 10;
  }
  return out;
}
