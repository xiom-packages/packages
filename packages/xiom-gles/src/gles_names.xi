/// Runtime-load candidate sonames (GLES side), probed in order by the
/// bridge: the Windows ANGLE DLLs (retained) then the Android system
/// libraries.  Mirrors the xgs_pairs table in src/gles_probe.c.
pub fn gles_load_candidates() -> Vec[Str] {
  var v: Vec[Str] = Vec[Str].new();
  v.push("libGLESv2.dll");
  v.push("GLESv2.dll");
  v.push("libGLESv2.so");
  v.push("libGLESv3.so");
  v.push("libGLESv1_CM.so");
  return v;
}
