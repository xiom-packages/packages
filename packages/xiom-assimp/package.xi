package xiom_assimp {
  name: "xiom.assimp";
  version: "0.1.0";
  description: "Assimp bindings for 3D model import (OBJ, FBX, glTF, COLLADA) with safe design-by-contract wrappers";
  categories: ["graphics", "media"];
  keywords: ["assimp", "3d-models", "import", "obj", "fbx", "gltf"];
  license: "MIT OR Apache-2.0";
  repository: "https://github.com/xiom-packages/packages";
  authors: ["XIOM Team"];
  deps: { "xiom.std": "0.1.0" };
}
