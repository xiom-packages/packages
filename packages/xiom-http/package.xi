  repository: "https://github.com/xiom-packages/packages";
  authors: ["XIOM Team"];
  deps: { "xiom.std": "0.1.0", "xiom.string": "*", "xiom.encoding": "*", "xiom.io": "*", "xiom.convert": "*" };
}
