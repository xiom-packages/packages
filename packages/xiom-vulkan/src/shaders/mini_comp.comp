#version 450
// xiom.vulkan mini-RHI compute probe: v[i] = v[i] * 3 + 1 for 256 elements.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) buffer Data {
  uint v[256];
} data;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i < 256u) {
    data.v[i] = data.v[i] * 3u + 1u;
  }
}
