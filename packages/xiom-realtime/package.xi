package xiom_realtime {
  name: "xiom-realtime";
  version: "0.1.0";
  description: "Application-level realtime -- channels, rooms, presence, broadcast, ordering, ephemeral/durable events, built on xiom-websocket and xiom-micro";
  authors: ["XIOM Team"];
  deps: { "xiom-std": "0.1.0", "xiom-websocket": "0.1.0", "xiom-micro": "0.1.0" };
}
