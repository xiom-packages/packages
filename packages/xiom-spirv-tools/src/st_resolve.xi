      p_spv_opcode_string: if r56.is_ok { r56.value } else { 0 };
      p_spv_binary_parse: if r57.is_ok { r57.value } else { 0 };
      p_spv_optimizer_create: if r58.is_ok { r58.value } else { 0 };
      p_spv_optimizer_destroy: if r59.is_ok { r59.value } else { 0 };
      p_spv_optimizer_set_message_consumer: if r60.is_ok { r60.value } else { 0 };
      p_spv_optimizer_register_legalization_passes: if r61.is_ok { r61.value } else { 0 };
      p_spv_optimizer_register_performance_passes: if r62.is_ok { r62.value } else { 0 };
      p_spv_optimizer_register_size_passes: if r63.is_ok { r63.value } else { 0 };
      p_spv_optimizer_register_pass_from_flag: if r64.is_ok { r64.value } else { 0 };
      p_spv_optimizer_register_passes_from_flags: if r65.is_ok { r65.value } else { 0 };
      p_spv_optimizer_register_passes_from_flags_while_preserving_the_interface: if r66.is_ok { r66.value } else { 0 };
      p_spv_optimizer_run: if r67.is_ok { r67.value } else { 0 };
    };
    missing: missing
  };
}

/// Resolve every declared name and classify the two deltas:
/// names expected missing that resolved (DLL grew) and names
/// expected present that did not (ABI mismatch).
/// Complexity: O(symbols).
pub fn st_probe_names(handle: Int) -> StNameProbeReport {
  let names = st_oracle_names();
  var resolved = 0;
  var i = 0;
  while i < names.len() {
    let r = dl.dl_sym(handle, names[i]);
    if r.is_ok { resolved = resolved + 1; }
    i = i + 1;
  }
  let exported = st_exported_names();
  var exported_missing: Vec[Str] = Vec[Str].new();
  var j = 0;
  while j < exported.len() {
    let r2 = dl.dl_sym(handle, exported[j]);
    if !r2.is_ok { exported_missing.push(exported[j]); }
    j = j + 1;
  }
  let gap = st_missing_names();
  var gap_resolved: Vec[Str] = Vec[Str].new();
  var k = 0;
  while k < gap.len() {
    let r3 = dl.dl_sym(handle, gap[k]);
    if r3.is_ok { gap_resolved.push(gap[k]); }
    k = k + 1;
  }
  return StNameProbeReport{
    oracle_count: names.len();
    resolved_count: resolved;
    exported_missing: exported_missing;
    gap_resolved: gap_resolved
  };
}
