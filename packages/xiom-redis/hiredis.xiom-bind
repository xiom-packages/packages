# Redis hiredis FFI Bindings
# Target: hiredis.dll (Windows), libhiredis.so (Linux), libhiredis.dylib (macOS)

library "hiredis" {
  fn redisConnect(ip: str, port: i32) -> ptr;
  fn redisConnectWithTimeout(ip: str, port: i32, timeout_sec: f64, timeout_usec: f64) -> ptr;
  fn redisFree(c: ptr);
  fn redisCommand(c: ptr, format: str, ...) -> ptr;
  fn redisAppendCommand(c: ptr, format: str, ...) -> i32;
  fn redisGetReply(c: ptr, reply: ptr) -> i32;
  fn freeReplyObject(reply: ptr);

  fn redisReplyType(reply: ptr) -> i32;
  fn redisReplyInteger(reply: ptr) -> i64;
  fn redisReplyString(reply: ptr, len: ptr) -> str;
  fn redisReplyArrayElements(reply: ptr) -> u64;
  fn redisReplyArrayElement(reply: ptr, index: u64) -> ptr;
}
