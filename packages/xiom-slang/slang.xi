/// Release a loaded library handle.
/// Complexity: O(1).
pub fn slang_close(lib: &SlangLibrary) -> Result[Unit, Str]
  requires: lib.handle != 0
{
  return dl.dl_close(lib.handle);
}

/// Total resolved-name count across every family (the suite's
/// resolved=N/N metric; N is SLANG_SYMBOL_COUNT in xiom.slang.syms).
/// Complexity: O(symbols).
pub fn slang_resolved_count(handle: Int) -> Int
  requires: handle != 0
{
  var my_n = 0;
  my_n = my_n + count_slangapi(handle);
  my_n = my_n + count_legacy_top_p1(handle);
  my_n = my_n + count_legacy_top_p2(handle);
  my_n = my_n + count_legacy_top_p3(handle);
  my_n = my_n + count_sp_request(handle);
  my_n = my_n + count_refl_decl(handle);
  my_n = my_n + count_refl_func(handle);
  my_n = my_n + count_refl_generic(handle);
  my_n = my_n + count_refl_misc(handle);
  my_n = my_n + count_refl_typelayout_p1(handle);
  my_n = my_n + count_refl_typelayout_p2(handle);
  my_n = my_n + count_refl_type(handle);
  return my_n;
