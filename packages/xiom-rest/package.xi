package xiom_rest {
  name: "xiom.rest";
  version: "0.1.0";
  description: "REST resource routing, pagination, filtering, content negotiation, and OpenAPI helpers built on xiom.http";
  categories: ["web"];
  keywords: ["rest", "openapi", "routing", "pagination"];
  license: "MIT OR Apache-2.0";
  repository: "https://github.com/xiom-packages/packages";
  authors: ["XIOM Team"];
  deps: { "xiom.std": "0.1.0", "xiom.http": "0.1.0", "xiom.json": "0.1.0" };
}
