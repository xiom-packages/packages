package {
  name: "xiom.usd"
  version: "0.1.0"
  description: "OpenUSD (Pixar Universal Scene Description) v26.08 scene-import bindings for XIOM -- stage open/traversal, prim name/type/path + authored attributes, mesh points/face-vertex counts/indices, UsdPreviewSurface material binding/inputs/connections, and time-sample essentials; runtime-trampolined usd-core 26.8 wheel with typed errors and SKIP-safe absence"
  categories: ["graphics", "assets"]
  keywords: ["binding", "usd", "openusd", "scene", "import", "material"]
  license: "MIT OR Apache-2.0"
  repository: "https://github.com/xiom-packages/packages"
  authors: ["XIOM Team"]
  deps: {
    "xiom.std": ">=0.60.0 <1.0.0"
  }
}


