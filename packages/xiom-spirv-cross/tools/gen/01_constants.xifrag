pub const SPVC_SIZEOF_SPVC_HLSL_VERTEX_ATTRIBUTE_REMAP: Int = 16;
pub const SPVC_SIZEOF_SPVC_MSL_CONSTEXPR_SAMPLER: Int = 52;
pub const SPVC_SIZEOF_SPVC_MSL_RESOURCE_BINDING: Int = 24;
pub const SPVC_SIZEOF_SPVC_MSL_RESOURCE_BINDING_2: Int = 28;
pub const SPVC_SIZEOF_SPVC_MSL_SAMPLER_YCBCR_CONVERSION: Int = 48;
pub const SPVC_SIZEOF_SPVC_MSL_SHADER_INTERFACE_VAR: Int = 16;
pub const SPVC_SIZEOF_SPVC_MSL_SHADER_INTERFACE_VAR_2: Int = 20;
pub const SPVC_SIZEOF_SPVC_MSL_VERTEX_ATTRIBUTE: Int = 28;
pub const SPVC_SIZEOF_SPVC_REFLECTED_BUILTIN_RESOURCE: Int = 32;
pub const SPVC_SIZEOF_SPVC_REFLECTED_RESOURCE: Int = 24;
pub const SPVC_SIZEOF_SPVC_SPECIALIZATION_CONSTANT: Int = 8;

/// SPVC_MAKE_MSL_VERSION(major, minor, patch) -- header macro.
/// Complexity: O(1).
pub fn spvc_make_msl_version(major: Int, minor: Int, patch: Int) -> Int {
  return (major * 10000) + (minor * 100) + (patch);
}

