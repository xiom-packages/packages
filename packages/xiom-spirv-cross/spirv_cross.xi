/// SPVC_MAKE_MSL_VERSION(major, minor, patch) -- header macro.
/// Complexity: O(1).
pub fn spvc_make_msl_version(major: Int, minor: Int, patch: Int) -> Int {
  return (major * 10000) + (minor * 100) + (patch);
}


