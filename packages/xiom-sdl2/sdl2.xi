/// Release a loaded library handle.
pub fn sdl2_close(lib: &Sdl2Library) -> Result[Unit, Str]
  requires: lib.handle != 0
{
  return dl.dl_close(lib.handle);
}

/// SDL_VERSIONNUM(major, minor, patch) arithmetic (SDL_version.h).
pub fn sdl2_versionnum(major: Int, minor: Int, patch: Int) -> Int
  requires: major > 0
  requires: minor >= 0
  requires: patch >= 0
{
  return (major * 1000 + minor) * 1000 + patch;
}
