pub fn sdl2_wcscmp(syms: &Sdl2StdincF3Symbols, str1: *UInt8, str2: *UInt8) -> Int
  requires: syms.handle != 0
{
  unsafe {
    let f = syms.p_sdl2_wcscmp as fn(*UInt8, *UInt8) -> Int32;
    return f(str1, str2) as Int;
  }
}
