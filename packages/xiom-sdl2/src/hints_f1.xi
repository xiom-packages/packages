  let a3 = dl.dl_sym(handle, "SDL_DelHintCallback");
  if !a3.is_ok { return Err("SDL_DelHintCallback: " + a3.error); }
  let a4 = dl.dl_sym(handle, "SDL_GetHint");
  if !a4.is_ok { return Err("SDL_GetHint: " + a4.error); }
  let a5 = dl.dl_sym(handle, "SDL_GetHintBoolean");
  if !a5.is_ok { return Err("SDL_GetHintBoolean: " + a5.error); }
  let a6 = dl.dl_sym(handle, "SDL_ResetHint");
  if !a6.is_ok { return Err("SDL_ResetHint: " + a6.error); }
  let a7 = dl.dl_sym(handle, "SDL_ResetHints");
  if !a7.is_ok { return Err("SDL_ResetHints: " + a7.error); }
  let a8 = dl.dl_sym(handle, "SDL_SetHint");
  if !a8.is_ok { return Err("SDL_SetHint: " + a8.error); }
  let a9 = dl.dl_sym(handle, "SDL_SetHintWithPriority");
  if !a9.is_ok { return Err("SDL_SetHintWithPriority: " + a9.error); }
  return Ok(Sdl2HintsF1Symbols{
    handle: handle,
    p_sdl2_add_hint_callback: a1.value,
    p_sdl2_clear_hints: a2.value,
    p_sdl2_del_hint_callback: a3.value,
    p_sdl2_get_hint: a4.value,
    p_sdl2_get_hint_boolean: a5.value,
    p_sdl2_reset_hint: a6.value,
    p_sdl2_reset_hints: a7.value,
    p_sdl2_set_hint: a8.value,
    p_sdl2_set_hint_with_priority: a9.value,
  });
}

pub fn sdl2_add_hint_callback(syms: &Sdl2HintsF1Symbols, name: Str, callback: fn(Int, Int, Int, Int) -> Unit, userdata: Int)
  requires: syms.handle != 0
{
  unsafe {
    let f = syms.p_sdl2_add_hint_callback as fn(*UInt8, fn(Int, Int, Int, Int) -> Unit, Int);
    f(name.c_str(), callback, userdata);
  }
}

pub fn sdl2_clear_hints(syms: &Sdl2HintsF1Symbols)
  requires: syms.handle != 0
{
  unsafe {
    let f = syms.p_sdl2_clear_hints as fn();
    f();
  }
}

pub fn sdl2_del_hint_callback(syms: &Sdl2HintsF1Symbols, name: Str, callback: fn(Int, Int, Int, Int) -> Unit, userdata: Int)
  requires: syms.handle != 0
{
  unsafe {
    let f = syms.p_sdl2_del_hint_callback as fn(*UInt8, fn(Int, Int, Int, Int) -> Unit, Int);
    f(name.c_str(), callback, userdata);
  }
}

pub fn sdl2_get_hint(syms: &Sdl2HintsF1Symbols, name: Str) -> Str
  requires: syms.handle != 0
{
  unsafe {
    let f = syms.p_sdl2_get_hint as fn(*UInt8) -> *UInt8;
    let p = f(name.c_str());
    if (p as Int) == 0 { return ""; }
    return Str::from_c_str(p);
  }
}

