pub fn sdl2_joystick_name(syms: &Sdl2JoystickF1Symbols, joystick: Int) -> Str
  requires: syms.handle != 0
{
  unsafe {
    let f = syms.p_sdl2_joystick_name as fn(Int) -> *UInt8;
    let p = f(joystick);
    if (p as Int) == 0 { return ""; }
    return Str::from_c_str(p);
  }
}

pub fn sdl2_joystick_name_for_index(syms: &Sdl2JoystickF1Symbols, device_index: Int) -> Str
  requires: syms.handle != 0
{
  unsafe {
    let f = syms.p_sdl2_joystick_name_for_index as fn(Int) -> *UInt8;
    let p = f(device_index);
    if (p as Int) == 0 { return ""; }
    return Str::from_c_str(p);
  }
}

pub fn sdl2_joystick_num_axes(syms: &Sdl2JoystickF1Symbols, joystick: Int) -> Int
  requires: syms.handle != 0
{
  unsafe {
    let f = syms.p_sdl2_joystick_num_axes as fn(Int) -> Int32;
    return f(joystick) as Int;
  }
}
