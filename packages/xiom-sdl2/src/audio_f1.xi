pub fn sdl2_unlock_audio_device(syms: &Sdl2AudioF1Symbols, dev: Int)
  requires: syms.handle != 0
{
  unsafe {
    let f = syms.p_sdl2_unlock_audio_device as fn(Int);
    f(dev);
  }
}
