package xiom_math {
  name: "xiom.math";
  version: "0.1.0";
  description: "Production-grade native XIOM math library: Vec2, Vec3, Vec4, Mat4 (column-major, Vulkan), Quat";
  categories: ["core"];
  keywords: ["math", "vec", "matrix", "quaternion", "simd", "linear-algebra"];
  license: "MIT OR Apache-2.0";
  repository: "https://github.com/xiom-packages/packages";
  authors: ["XIOM Team"];
  deps: {
    "xiom.std": "0.1.0"
  };
}
