/// Group name for a group id.
/// Complexity: O(1).
pub fn phonon_group_name(g: Int) -> Str
  requires: g >= 0
  requires: g < PHONON_GROUP_COUNT
{
  if g == 0 { return "context"; }
  if g == 1 { return "hrtf"; }
  if g == 2 { return "audio_buffer"; }
  if g == 3 { return "binaural"; }
  if g == 4 { return "panning"; }
  if g == 5 { return "virtual_surround"; }
  if g == 6 { return "ambisonics_encode"; }
  if g == 7 { return "ambisonics_panning"; }
  if g == 8 { return "ambisonics_binaural"; }
  if g == 9 { return "ambisonics_rotation"; }
  if g == 10 { return "ambisonics_decode"; }
  if g == 11 { return "direct_effect"; }
  if g == 12 { return "path_effect"; }
  if g == 13 { return "pathing_helpers"; }
  return "unknown";
}

