/// The declared (typed-wrapper) surface, in group then header order.
/// Complexity: O(n).
pub fn phonon_declared_export_names() -> Vec[Str]
  requires: true
{
  var out: Vec[Str] = Vec[Str].new();
  out.push("iplContextCreate");
  out.push("iplContextRetain");
  out.push("iplContextRelease");
  out.push("iplHRTFCreate");
  out.push("iplHRTFRetain");
  out.push("iplHRTFRelease");
  out.push("iplAudioBufferAllocate");
  out.push("iplAudioBufferFree");
  out.push("iplAudioBufferInterleave");
  out.push("iplAudioBufferDeinterleave");
  out.push("iplAudioBufferMix");
  out.push("iplAudioBufferDownmix");
  out.push("iplAudioBufferConvertAmbisonics");
  out.push("iplBinauralEffectCreate");
  out.push("iplBinauralEffectRetain");
  out.push("iplBinauralEffectRelease");
  out.push("iplBinauralEffectReset");
  out.push("iplBinauralEffectApply");
  out.push("iplBinauralEffectGetTailSize");
  out.push("iplBinauralEffectGetTail");
  out.push("iplPanningEffectCreate");
  out.push("iplPanningEffectRetain");
  out.push("iplPanningEffectRelease");
  out.push("iplPanningEffectReset");
  out.push("iplPanningEffectApply");
  out.push("iplPanningEffectGetTailSize");
  out.push("iplPanningEffectGetTail");
  out.push("iplVirtualSurroundEffectCreate");
  out.push("iplVirtualSurroundEffectRetain");
  out.push("iplVirtualSurroundEffectRelease");
  out.push("iplVirtualSurroundEffectReset");
  out.push("iplVirtualSurroundEffectApply");
  out.push("iplVirtualSurroundEffectGetTailSize");
  out.push("iplVirtualSurroundEffectGetTail");
  out.push("iplAmbisonicsEncodeEffectCreate");
  out.push("iplAmbisonicsEncodeEffectRetain");
  out.push("iplAmbisonicsEncodeEffectRelease");
  out.push("iplAmbisonicsEncodeEffectReset");
  out.push("iplAmbisonicsEncodeEffectApply");
  out.push("iplAmbisonicsEncodeEffectGetTailSize");
  out.push("iplAmbisonicsEncodeEffectGetTail");
  out.push("iplAmbisonicsPanningEffectCreate");
  out.push("iplAmbisonicsPanningEffectRetain");
  out.push("iplAmbisonicsPanningEffectRelease");
  out.push("iplAmbisonicsPanningEffectReset");
  out.push("iplAmbisonicsPanningEffectApply");
  out.push("iplAmbisonicsPanningEffectGetTailSize");
  out.push("iplAmbisonicsPanningEffectGetTail");
  out.push("iplAmbisonicsBinauralEffectCreate");
  out.push("iplAmbisonicsBinauralEffectRetain");
  out.push("iplAmbisonicsBinauralEffectRelease");
  out.push("iplAmbisonicsBinauralEffectReset");
  out.push("iplAmbisonicsBinauralEffectApply");
  out.push("iplAmbisonicsBinauralEffectGetTailSize");
  out.push("iplAmbisonicsBinauralEffectGetTail");
  out.push("iplAmbisonicsRotationEffectCreate");
  out.push("iplAmbisonicsRotationEffectRetain");
  out.push("iplAmbisonicsRotationEffectRelease");
  out.push("iplAmbisonicsRotationEffectReset");
  out.push("iplAmbisonicsRotationEffectApply");
  out.push("iplAmbisonicsRotationEffectGetTailSize");
  out.push("iplAmbisonicsRotationEffectGetTail");
  out.push("iplAmbisonicsDecodeEffectCreate");
  out.push("iplAmbisonicsDecodeEffectRetain");
  out.push("iplAmbisonicsDecodeEffectRelease");
  out.push("iplAmbisonicsDecodeEffectReset");
  out.push("iplAmbisonicsDecodeEffectApply");
  out.push("iplAmbisonicsDecodeEffectGetTailSize");
  out.push("iplAmbisonicsDecodeEffectGetTail");
  out.push("iplDirectEffectCreate");
  out.push("iplDirectEffectRetain");
  out.push("iplDirectEffectRelease");
  out.push("iplDirectEffectReset");
  out.push("iplDirectEffectApply");
  out.push("iplDirectEffectGetTailSize");
  out.push("iplDirectEffectGetTail");
  out.push("iplPathEffectCreate");
  out.push("iplPathEffectRetain");
  out.push("iplPathEffectRelease");
  out.push("iplPathEffectReset");
  out.push("iplPathEffectApply");
  out.push("iplPathEffectGetTailSize");
  out.push("iplPathEffectGetTail");
  out.push("iplCalculateRelativeDirection");
  out.push("iplDistanceAttenuationCalculate");
  out.push("iplAirAbsorptionCalculate");
  out.push("iplDirectivityCalculate");
  return out;
}

/// Per-group declared export counts, aligned with PHONON_GROUP_* ids.
/// Complexity: O(1).
pub fn phonon_group_export_count(g: Int) -> Int
  requires: g >= 0
  requires: g < PHONON_GROUP_COUNT
{
  if g == 0 { return 3; }
  if g == 1 { return 3; }
  if g == 2 { return 7; }
  if g == 3 { return 7; }
  if g == 4 { return 7; }
  if g == 5 { return 7; }
  if g == 6 { return 7; }
  if g == 7 { return 7; }
  if g == 8 { return 7; }
  if g == 9 { return 7; }
  if g == 10 { return 7; }
  if g == 11 { return 7; }
  if g == 12 { return 7; }
  if g == 13 { return 4; }
  return 0;
}

/// Indexes (into the header-order table) of one group's exports.
/// Complexity: O(n).
pub fn phonon_group_export_indexes(g: Int) -> Vec[Int]
  requires: g >= 0
  requires: g < PHONON_GROUP_COUNT
{
  var out: Vec[Int] = Vec[Int].new();
  if g == 0 {
    out.push(0);
    out.push(1);
    out.push(2);
  }
  if g == 1 {
    out.push(55);
    out.push(56);
    out.push(57);
  }
  if g == 2 {
    out.push(48);
    out.push(49);
    out.push(50);
    out.push(51);
    out.push(52);
    out.push(53);
    out.push(54);
  }
  if g == 3 {
    out.push(65);
    out.push(66);
    out.push(67);
    out.push(68);
    out.push(69);
    out.push(70);
    out.push(71);
  }
  if g == 4 {
    out.push(58);
    out.push(59);
    out.push(60);
    out.push(61);
    out.push(62);
    out.push(63);
    out.push(64);
  }
  if g == 5 {
    out.push(72);
    out.push(73);
    out.push(74);
    out.push(75);
    out.push(76);
    out.push(77);
    out.push(78);
  }
  if g == 6 {
    out.push(79);
    out.push(80);
    out.push(81);
    out.push(82);
    out.push(83);
    out.push(84);
    out.push(85);
  }
  if g == 7 {
    out.push(86);
    out.push(87);
    out.push(88);
    out.push(89);
    out.push(90);
    out.push(91);
    out.push(92);
  }
  if g == 8 {
    out.push(93);
    out.push(94);
    out.push(95);
    out.push(96);
    out.push(97);
    out.push(98);
    out.push(99);
  }
  if g == 9 {
    out.push(100);
    out.push(101);
    out.push(102);
    out.push(103);
    out.push(104);
    out.push(105);
    out.push(106);
  }
  if g == 10 {
    out.push(107);
    out.push(108);
    out.push(109);
    out.push(110);
    out.push(111);
    out.push(112);
    out.push(113);
  }
  if g == 11 {
    out.push(114);
    out.push(115);
    out.push(116);
    out.push(117);
    out.push(118);
    out.push(119);
    out.push(120);
  }
  if g == 12 {
    out.push(133);
    out.push(134);
    out.push(135);
    out.push(136);
    out.push(137);
    out.push(138);
    out.push(139);
  }
  if g == 13 {
    out.push(3);
    out.push(213);
    out.push(214);
    out.push(215);
  }
  return out;
}
