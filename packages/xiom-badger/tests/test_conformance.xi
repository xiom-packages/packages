// XIOM -- xiom.badger conformance tests (21 checks)
// Copyright (c) 2026 Eleftherios Notas and The XIOM Authors
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Covers the v1.6.2 byte-compatible API against synthetic buffers assembled
// in-test. Four fixtures are byte-for-byte outputs of the upstream v1.6.2
// code, generated by compiling dgraph-io/badger @ v1.6.2 with Go and embedded
// as hex/JSON text (no external data files at run time):
//   * VLOG_HEX: three value-log entries (plain, bitTxn, bitFinTxn) written
//     exactly per structs.go encodeEntry;
//   * MANIFEST_HEX + BODY1/BODY2: header "Bdgr"+4 and two records produced
//     by the real pb.ManifestChangeSet protobuf plus y.CastagnoliCrcTable;
//   * TABLE_SMALL_HEX: a 237-byte table emitted by table.NewTableBuilder()
//     with three entries (delete meta, value-pointer meta + expiry, plain),
//     its block index and its bbloom JSON envelope;
//   * TABLE_SMALL_SHA256: the digest v1.6.2 loadToRAM computes over the
//     table bytes.
// All other fixtures are assembled byte by byte in-test. The local CRC32C
// helper is written independently of the module (bit-serial reference).
// Str equality goes through str_compare (BUG 17 discipline: `==` on a Str
// read from a Vec lowers to a pointer comparison).

module badger_tests
use xiom.io; use xiom.test;
use xiom.badger;
use xiom.string;
use xiom.string.compare;

// --------------------------------------------------
//  Generic test helpers
// --------------------------------------------------

fn str_eq(a: Str, b: Str) -> Bool {
  return compare.str_compare(a, b) == 0;
}

fn int_is(r: Result[Int, Str], want: Int) -> Bool {
  if !r.is_ok { return false; }
  let v: Int = r.value;
  return v == want;
}

fn bool_is(r: Result[Bool, Str], want: Bool) -> Bool {
  if !r.is_ok { return false; }
  let v: Bool = r.value;
  if v == want { return true; }
  return false;
}

fn err_int_is(r: Result[Int, Str], want: Str) -> Bool {
  if r.is_ok { return false; }
  return str_eq(r.error, want);
}

fn err_bool_is(r: Result[Bool, Str], want: Str) -> Bool {
  if r.is_ok { return false; }
  return str_eq(r.error, want);
}

fn err_vp_is(r: Result[BadgerValuePointer, Str], want: Str) -> Bool {
  if r.is_ok { return false; }
  return str_eq(r.error, want);
}

