  fn spvReflectGetCode(p_module: Int) -> Int;
  fn spvReflectGetEntryPoint(p_module: Int, entry_point: Int) -> Int;
  fn spvReflectEnumerateDescriptorBindings(p_module: Int, p_count: Int, pp_bindings: Int) -> Int32;
  fn spvReflectEnumerateEntryPointDescriptorBindings(p_module: Int, entry_point: Int, p_count: Int, pp_bindings: Int) -> Int32;
  fn spvReflectEnumerateDescriptorSets(p_module: Int, p_count: Int, pp_sets: Int) -> Int32;
  fn spvReflectEnumerateEntryPointDescriptorSets(p_module: Int, entry_point: Int, p_count: Int, pp_sets: Int) -> Int32;
  fn spvReflectEnumerateInterfaceVariables(p_module: Int, p_count: Int, pp_variables: Int) -> Int32;
  fn spvReflectEnumerateEntryPointInterfaceVariables(p_module: Int, entry_point: Int, p_count: Int, pp_variables: Int) -> Int32;
