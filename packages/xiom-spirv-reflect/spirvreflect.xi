  magic_rc: Int;
  magic_null: Bool;
  short_rc: Int;
  short_null: Bool;
  trunc_rc: Int;
  trunc_null: Bool;
}

/// Error paths: garbage words (bad magic) -> INVALID_MAGIC_NUMBER(10);
/// undersized words -> INVALID_CODE_SIZE(9); truncated byte size -> 9; every
/// failed create leaves the module with a NULL internal (destroy-safe).
/// Complexity: O(1).
pub fn spirv_reflect_error_report() -> SpvReflectErrorReport
  requires: true
{
  unsafe {
    var s0 = spv_slot4();
    var s1 = spv_slot4();
    var s2 = spv_slot4();
    var s3 = spv_slot4();
    var s4 = spv_slot4();
    var s5 = spv_slot4();
    xspv_error_probe(s0.as_mut_ptr(), s1.as_mut_ptr(), s2.as_mut_ptr(), s3.as_mut_ptr(), s4.as_mut_ptr(), s5.as_mut_ptr());
    return SpvReflectErrorReport{
      magic_rc: spv_read_u32(&s0),
      magic_null: spv_read_u32(&s1) != 0,
      short_rc: spv_read_u32(&s2),
      short_null: spv_read_u32(&s3) != 0,
      trunc_rc: spv_read_u32(&s4),
      trunc_null: spv_read_u32(&s5) != 0
    };
  }
}

pub type SpvReflectFreeReport = {
  c1: Int;
  c2: Int;
  stage2: Int;
  empty_destroy_ok: Bool;
}

/// Free chain: create/destroy, create/destroy again (stage read between),
/// then destroy an empty (zeroed) module -- the upstream destroy contract.
/// Complexity: O(module).
pub fn spirv_reflect_free_chain_report() -> SpvReflectFreeReport
  requires: true
{
  unsafe {
    var s0 = spv_slot4();
    var s1 = spv_slot4();
    var s2 = spv_slot4();
    var s3 = spv_slot4();
    xspv_free_chain_probe(s0.as_mut_ptr(), s1.as_mut_ptr(), s2.as_mut_ptr(), s3.as_mut_ptr());
    return SpvReflectFreeReport{
      c1: spv_read_u32(&s0),
      c2: spv_read_u32(&s1),
      stage2: spv_read_u32(&s2),
      empty_destroy_ok: spv_read_u32(&s3) != 0
    };
  }
}
