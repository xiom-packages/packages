// =========================================================================
// FFI: the raw 45-function C API surface (100% of spirv_reflect.h).
// Declarations only -- pass 0 for NULL, Int for every pointer. Consumers
// should prefer the xspv_* report wrappers below for the owned-slot ABI.
// =========================================================================

extern "C" {
  fn spvReflectCreateShaderModule(size: Int, p_code: Int, p_module: Int) -> Int32;
