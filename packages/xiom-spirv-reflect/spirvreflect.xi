// =========================================================================
// Bridge probes (src/spvref_bridge.c) -- out-params are XIOM-owned slots.
// =========================================================================

extern "C" {
  fn xspv_api_count() -> Int32;
  fn xspv_resolve_all(api_count: *UInt8, null_count: *UInt8) -> Int32;
  fn xspv_create_probe(rc: *UInt8, stage: *UInt8, model: *UInt8, entry_count: *UInt8, code_size: *UInt8, source_lang: *UInt8, source_version: *UInt8, generator: *UInt8, code_nonnull: *UInt8, entry_nonnull: *UInt8, name_len: *UInt8, name: *UInt8) -> Int32;
  fn xspv_create2_probe(rc: *UInt8, stage: *UInt8, flags_out: *UInt8) -> Int32;
  fn xspv_descriptor_probe(enum_rc: *UInt8, bind_count: *UInt8, bind_rc: *UInt8, set_count: *UInt8, set_rc: *UInt8, binding_number: *UInt8, set_number: *UInt8, descriptor_type: *UInt8) -> Int32;
  fn xspv_variable_probe(in_rc: *UInt8, in_count: *UInt8, out_rc: *UInt8, out_count: *UInt8, iface_rc: *UInt8, iface_count: *UInt8, in_location: *UInt8, in_format: *UInt8, out_location: *UInt8, out_format: *UInt8, name_matches_uv: *UInt8, name_len: *UInt8, name: *UInt8) -> Int32;
  fn xspv_entrypoint_probe(ep_model: *UInt8, ep_stage: *UInt8, bind_count: *UInt8, bind_rc: *UInt8, set_count: *UInt8, in_count: *UInt8, out_count: *UInt8, iface_count: *UInt8, push_count: *UInt8, spec_count: *UInt8, bind_get_ok: *UInt8, set_get_ok: *UInt8, in_location_get_ok: *UInt8, out_location_get_ok: *UInt8, in_semantic_rc: *UInt8, out_semantic_rc: *UInt8, push_rc: *UInt8, dep_enum_push_rc: *UInt8, dep_enum_push_count: *UInt8, push_blocks_rc: *UInt8, push_blocks_count: *UInt8) -> Int32;
  fn xspv_get_probe(bind_rc: *UInt8, bind_ok: *UInt8, set_rc: *UInt8, set_ok: *UInt8, in_rc: *UInt8, in_ok: *UInt8, out_rc: *UInt8, out_ok: *UInt8, in_semantic_rc: *UInt8, out_semantic_rc: *UInt8, push_rc: *UInt8) -> Int32;
  fn xspv_alias_probe(create_rc: *UInt8, stage: *UInt8, in_ok: *UInt8, out_ok: *UInt8, push_rc: *UInt8, change_rc: *UInt8, code_size: *UInt8) -> Int32;
  fn xspv_change_probe(chg_bind_rc: *UInt8, get_after_rc: *UInt8, get_after_ok: *UInt8, new_binding: *UInt8, new_set: *UInt8, chg_set_rc: *UInt8, get_set_after_ok: *UInt8, chg_in_rc: *UInt8, in_loc_after_ok: *UInt8, chg_out_rc: *UInt8, out_loc_after_ok: *UInt8) -> Int32;
  fn xspv_spec_probe(enum_rc: *UInt8, spec_count: *UInt8, constant_id: *UInt8, default_size: *UInt8, name_len: *UInt8, name: *UInt8) -> Int32;
  fn xspv_strings_probe(lang_len: *UInt8, lang: *UInt8, type_name_len: *UInt8, type_name: *UInt8, null_name_is_null: *UInt8) -> Int32;
  fn xspv_error_probe(magic_rc: *UInt8, magic_null: *UInt8, short_rc: *UInt8, short_null: *UInt8, trunc_rc: *UInt8, trunc_null: *UInt8) -> Int32;
  fn xspv_free_chain_probe(c1: *UInt8, c2: *UInt8, stage2: *UInt8, empty_destroy_ok: *UInt8) -> Int32;
}

// =========================================================================
// Owned-slot helpers (B-11: byte-indexed reads/writes only).
// =========================================================================

fn spv_slot4() -> Vec[UInt8]
  requires: true
{
  var s: Vec[UInt8] = Vec[UInt8].new();
  var i: Int = 0;
  while i < 4 {
    s.push(0 as UInt8);
    i = i + 1;
  }
  return s;
}

fn spv_slot_bytes(n: Int) -> Vec[UInt8]
  requires: n > 0
{
  var s: Vec[UInt8] = Vec[UInt8].new();
  var i: Int = 0;
  while i < n {
    s.push(0 as UInt8);
    i = i + 1;
  }
  return s;
}

fn spv_read_u32(buf: &Vec[UInt8]) -> Int
  requires: buf.len() >= 4
{
  let b0 = buf[0] as Int;
  let b1 = buf[1] as Int;
  let b2 = buf[2] as Int;
  let b3 = buf[3] as Int;
  return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

/// Copy the first `n` bytes of an XIOM-owned slot into a Str (C wrote it
/// NUL-terminated; n is the reported length).  Complexity: O(n).
fn spv_slot_str(buf: &Vec[UInt8], n: Int) -> Str
  requires: n >= 0
  requires: buf.len() >= n
{
  if n <= 0 { return ""; }
  var b: Vec[UInt8] = Vec[UInt8].new();
  var i: Int = 0;
  while i < n {
    b.push(buf[i]);
    i = i + 1;
  }
  let r = encoding.utf8_decode(&b);
  if r.is_ok { return r.value; }
  return "";
}

// =========================================================================
// Report wrappers -- the consumer-facing safe surface over the probes.
// =========================================================================

pub type SpvReflectResolveReport = {
  api_count: Int;
  null_count: Int;
}

/// Resolve surface: one non-NULL pointer per public C API function
/// (link-time resolution proof for the vendored route).
/// Complexity: O(api_count).
pub fn spirv_reflect_resolve() -> SpvReflectResolveReport
  requires: true
{
  unsafe {
    var sc = spv_slot4();
    var sn = spv_slot4();
    xspv_resolve_all(sc.as_mut_ptr(), sn.as_mut_ptr());
    return SpvReflectResolveReport{
      api_count: spv_read_u32(&sc),
      null_count: spv_read_u32(&sn)
    };
  }
}

/// Public C API function count (oracle: 45 for the pinned header).
/// Complexity: O(1).
pub fn spirv_reflect_api_count() -> Int
  requires: true
{
  return unsafe { xspv_api_count() as Int };
}

pub type SpvReflectCreateReport = {
  rc: Int;
  stage: Int;
  model: Int;
  entry_count: Int;
  code_size: Int;
  source_lang: Int;
  source_version: Int;
  generator: Int;
  code_ok: Bool;
  entry_ok: Bool;
  entry_name: Str;
}

/// Create a module from the embedded minimal fragment fixture and read the
/// module header: stage, execution model, entry point, code size, language.
/// Complexity: O(module).
pub fn spirv_reflect_create_report() -> SpvReflectCreateReport
  requires: true
{
  unsafe {
    var s0 = spv_slot4();
    var s1 = spv_slot4();
    var s2 = spv_slot4();
    var s3 = spv_slot4();
    var s4 = spv_slot4();
    var s5 = spv_slot4();
    var s6 = spv_slot4();
    var s7 = spv_slot4();
    var s8 = spv_slot4();
    var s9 = spv_slot4();
    var s10 = spv_slot4();
    var name = spv_slot_bytes(32);
    xspv_create_probe(s0.as_mut_ptr(), s1.as_mut_ptr(), s2.as_mut_ptr(), s3.as_mut_ptr(), s4.as_mut_ptr(), s5.as_mut_ptr(), s6.as_mut_ptr(), s7.as_mut_ptr(), s8.as_mut_ptr(), s9.as_mut_ptr(), s10.as_mut_ptr(), name.as_mut_ptr());
    return SpvReflectCreateReport{
      rc: spv_read_u32(&s0),
      stage: spv_read_u32(&s1),
      model: spv_read_u32(&s2),
      entry_count: spv_read_u32(&s3),
      code_size: spv_read_u32(&s4),
      source_lang: spv_read_u32(&s5),
      source_version: spv_read_u32(&s6),
      generator: spv_read_u32(&s7),
      code_ok: spv_read_u32(&s8) != 0,
      entry_ok: spv_read_u32(&s9) != 0,
      entry_name: spv_slot_str(&name, spv_read_u32(&s10))
    };
  }
}

