package {
  name: "xiom.spirv-reflect"
  version: "0.1.0"
  description: "SPIRV-Reflect bindings for XIOM (SPIR-V shader reflection: descriptor bindings, interface variables, push constants)"
  categories: ["graphics"]
  keywords: ["spirv", "reflect", "vulkan", "shader", "binding"]
  license: "MIT OR Apache-2.0"
  repository: "https://github.com/xiom-packages/packages"
  authors: ["XIOM Team"]
  deps: {
    "xiom.std": ">=0.60.0 <1.0.0"
  }
}
