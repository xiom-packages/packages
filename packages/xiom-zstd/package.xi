package xiom_zstd {
  name: "xiom.zstd";
  version: "0.2.0";
  description: "Zstandard bindings for XIOM (vendored 1.5.7 single-file amalgamation, no system library)";
  categories: ["data"];
  keywords: ["zstd", "compression", "streaming", "binding"];
  license: "MIT OR Apache-2.0";
  repository: "https://github.com/xiom-packages/packages";
  authors: ["XIOM Team"];
  deps: { "xiom.std": ">=0.60.0 <1.0.0" };
}
