// Category ids follow 0=Lu, 1=Ll, 2=Lt, 3=Lm, 4=Lo, 5=Mn, 6=Mc, 7=Me, 8=Nd, 9=Nl, 10=No, 11=Pc, 12=Pd, 13=Ps, 14=Pe, 15=Pi, 16=Pf, 17=Po, 18=Sm, 19=Sc, 20=Sk, 21=So, 22=Zs, 23=Zl, 24=Zp, 25=Cc, 26=Cf, 27=Co, 28=Cs, 29=Cn.

pub fn cat_name(id: Int) -> Str {
  if id == 0 { return "Lu"; }
  if id == 1 { return "Ll"; }
  if id == 2 { return "Lt"; }
  if id == 3 { return "Lm"; }
  if id == 4 { return "Lo"; }
  if id == 5 { return "Mn"; }
  if id == 6 { return "Mc"; }
  if id == 7 { return "Me"; }
  if id == 8 { return "Nd"; }
  if id == 9 { return "Nl"; }
  if id == 10 { return "No"; }
  if id == 11 { return "Pc"; }
  if id == 12 { return "Pd"; }
  if id == 13 { return "Ps"; }
  if id == 14 { return "Pe"; }
  if id == 15 { return "Pi"; }
  if id == 16 { return "Pf"; }
  if id == 17 { return "Po"; }
  if id == 18 { return "Sm"; }
  if id == 19 { return "Sc"; }
  if id == 20 { return "Sk"; }
  if id == 21 { return "So"; }
  if id == 22 { return "Zs"; }
  if id == 23 { return "Zl"; }
  if id == 24 { return "Zp"; }
  if id == 25 { return "Cc"; }
  if id == 26 { return "Cf"; }
  if id == 27 { return "Co"; }
  if id == 28 { return "Cs"; }
  if id == 29 { return "Cn"; }
  return "";
}

