pub fn wb_name(id: Int) -> Str {
  if id == 0 { return "Other"; }
  if id == 1 { return "CR"; }
  if id == 2 { return "LF"; }
  if id == 3 { return "Newline"; }
  if id == 4 { return "Extend"; }
  if id == 5 { return "ZWJ"; }
  if id == 6 { return "Format"; }
  if id == 7 { return "ALetter"; }
  if id == 8 { return "Numeric"; }
  if id == 9 { return "ExtendNumLet"; }
  if id == 10 { return "MidLetter"; }
  if id == 11 { return "MidNum"; }
  if id == 12 { return "MidNumLet"; }
  if id == 13 { return "SingleQuote"; }
  if id == 14 { return "DoubleQuote"; }
  if id == 15 { return "WSegSpace"; }
  if id == 16 { return "Regional_Indicator"; }
  return "";
}

// Extended_Pictographic subset: [lo, hi, 1] stride 3.
pub fn tbl_extpic() -> Vec[Int] {
  var t = Vec[Int].new();
  t.push(0xA9); t.push(0xA9); t.push(1); t.push(0xAE); t.push(0xAE); t.push(1); t.push(0x203C); t.push(0x203C); t.push(1);
  t.push(0x2049); t.push(0x2049); t.push(1); t.push(0x1F300); t.push(0x1F64F); t.push(1); t.push(0x1F680); t.push(0x1F6FF); t.push(1);
  t.push(0x1F900); t.push(0x1F9FF); t.push(1); t.push(0x1FA70); t.push(0x1FAFF); t.push(1);
  return t;
}

