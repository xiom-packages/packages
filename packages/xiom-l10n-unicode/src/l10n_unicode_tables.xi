pub fn block_name(id: Int) -> Str {
  if id == 0 { return "Basic Latin"; }
  if id == 1 { return "Latin-1 Supplement"; }
  if id == 2 { return "Latin Extended-A"; }
  if id == 3 { return "Latin Extended-B"; }
  if id == 4 { return "IPA Extensions"; }
  if id == 5 { return "Spacing Modifier Letters"; }
  if id == 6 { return "Combining Diacritical Marks"; }
  if id == 7 { return "Greek and Coptic"; }
  if id == 8 { return "Cyrillic"; }
  if id == 9 { return "Latin Extended Additional"; }
  if id == 10 { return "General Punctuation"; }
  if id == 11 { return "Superscripts and Subscripts"; }
  if id == 12 { return "Currency Symbols"; }
  if id == 13 { return "Combining Diacritical Marks for Symbols"; }
  if id == 14 { return "Alphabetic Presentation Forms"; }
  if id == 15 { return "Variation Selectors"; }
  if id == 16 { return "Halfwidth and Fullwidth Forms"; }
  if id == 17 { return "Enclosed Alphanumeric Supplement"; }
  if id == 18 { return "Miscellaneous Symbols and Pictographs"; }
  if id == 19 { return "Emoticons"; }
  if id == 20 { return "Transport and Map Symbols"; }
  if id == 21 { return "Supplemental Symbols and Pictographs"; }
  if id == 22 { return "Symbols and Pictographs Extended-A"; }
  return "";
}

