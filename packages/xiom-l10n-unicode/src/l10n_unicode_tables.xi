pub fn script_name(id: Int) -> Str {
  if id == 0 { return "Latin"; }
  if id == 1 { return "Greek"; }
  if id == 2 { return "Cyrillic"; }
  if id == 3 { return "Common"; }
  if id == 4 { return "Inherited"; }
  return "";
}

