pub fn component_name(i: Int) -> Str
  requires: i >= 0
{
  if i == 0 { return "core"; }
  if i == 1 { return "fsr2"; }
  if i == 2 { return "fsr3upscaler"; }
  if i == 3 { return "spd"; }
  if i == 4 { return "fsr1"; }
  if i == 5 { return "frameinterpolation"; }
