  fn JPH_BodyCreationSettings_GetPosition(settings: ptr, out_x: ptr, out_y: ptr, out_z: ptr);
  fn JPH_BodyCreationSettings_GetRotation(settings: ptr, out_x: ptr, out_y: ptr, out_z: ptr, out_w: ptr);
  fn JPH_BodyCreationSettings_Destroy(settings: ptr);

  # Shapes — all types
  fn JPH_SphereShapeSettings_Create(radius: f32) -> ptr;
  fn JPH_BoxShapeSettings_Create(half_x: f32, half_y: f32, half_z: f32, convex_radius: f32) -> ptr;
  fn JPH_CapsuleShapeSettings_Create(half_height: f32, radius: f32) -> ptr;
  fn JPH_TaperedCapsuleShapeSettings_Create(half_height: f32, top_radius: f32, bottom_radius: f32) -> ptr;
  fn JPH_CylinderShapeSettings_Create(half_height: f32, radius: f32, convex_radius: f32) -> ptr;
  fn JPH_TaperedCylinderShapeSettings_Create(half_height: f32, top_radius: f32, bottom_radius: f32, convex_radius: f32) -> ptr;
  fn JPH_TriangleShapeSettings_Create(v1x: f32, v1y: f32, v1z: f32, v2x: f32, v2y: f32, v2z: f32, v3x: f32, v3y: f32, v3z: f32, convex_radius: f32) -> ptr;
  fn JPH_PlaneShapeSettings_Create(nx: f32, ny: f32, nz: f32, constant: f32) -> ptr;
  fn JPH_EmptyShapeSettings_Create() -> ptr;
  fn JPH_ConvexHullShapeSettings_Create(points: ptr, num_points: i32, stride: i32, max_convex_radius: f32) -> ptr;
  fn JPH_MeshShapeSettings_Create(vertices: ptr, num_vertices: i32, triangles: ptr, num_triangles: i32) -> ptr;
  fn JPH_HeightFieldShapeSettings_Create(height_map: ptr, material_indices: ptr, sample_count: i32, block_size: i32, offset_x: f32, offset_y: f32, offset_z: f32, scale_x: f32, scale_y: f32, scale_z: f32) -> ptr;
  fn JPH_StaticCompoundShapeSettings_Create() -> ptr;
  fn JPH_StaticCompoundShapeSettings_AddShape(settings: ptr, shape: ptr, px: f32, py: f32, pz: f32, qx: f32, qy: f32, qz: f32, qw: f32, user_data: i32);
  fn JPH_MutableCompoundShapeSettings_Create() -> ptr;
  fn JPH_MutableCompoundShapeSettings_AddShape(settings: ptr, shape: ptr, px: f32, py: f32, pz: f32, qx: f32, qy: f32, qz: f32, qw: f32, user_data: i32);
  fn JPH_RotatedTranslatedShapeSettings_Create(inner: ptr, px: f32, py: f32, pz: f32, qx: f32, qy: f32, qz: f32, qw: f32) -> ptr;
  fn JPH_ScaledShapeSettings_Create(inner: ptr, sx: f32, sy: f32, sz: f32) -> ptr;
  fn JPH_OffsetCenterOfMassShapeSettings_Create(inner: ptr, ox: f32, oy: f32, oz: f32) -> ptr;
  fn JPH_ShapeSettings_CreateShape(settings: ptr) -> ptr;
  fn JPH_ShapeSettings_Destroy(settings: ptr);
  fn JPH_Shape_Destroy(shape: ptr);

