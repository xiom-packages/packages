# Jolt Physics FFI Bindings — Full Coverage
# Target: joltc.dll (C bridge, github.com/amerkoleci/joltc)
# JoltPhysics v5.6.0 — C++17, no C API. Requires joltc bridge.
#
# Build the C bridge:
#   git clone https://github.com/amerkoleci/joltc
#   cd joltc && cmake -B build && cmake --build build --config Release

# ============================================================================
# Init / Shutdown
# ============================================================================
library "joltc" {
  fn JPH_Init() -> i32;
  fn JPH_Shutdown();
  fn JPH_SetTraceHandler(handler: ptr);
  fn JPH_SetAssertFailureHandler(handler: ptr);

  # JobSystem
  fn JPH_JobSystemThreadPool_Create(max_jobs: i32, max_barriers: i32, num_threads: i32) -> ptr;
  fn JPH_JobSystem_Destroy(js: ptr);

  # BroadPhaseLayerInterface
  fn JPH_BroadPhaseLayerInterfaceTable_Create(num_obj_layers: i32, num_broad_layers: i32) -> ptr;
  fn JPH_BroadPhaseLayerInterfaceTable_MapObjectToBroadPhaseLayer(iface: ptr, obj_layer: i32, broad_layer: i32);
  fn JPH_BroadPhaseLayerInterfaceMask_Create(num_broad_layers: i32) -> ptr;
  fn JPH_BroadPhaseLayerInterfaceMask_ConfigureLayer(iface: ptr, broad_layer: i32, groups_include: i32, groups_exclude: i32);
  fn JPH_BroadPhaseLayerInterface_Destroy(iface: ptr);

  # ObjectLayerPairFilter
  fn JPH_ObjectLayerPairFilterTable_Create(num_obj_layers: i32) -> ptr;
  fn JPH_ObjectLayerPairFilterTable_DisableCollision(filter: ptr, layer1: i32, layer2: i32);
  fn JPH_ObjectLayerPairFilterTable_EnableCollision(filter: ptr, layer1: i32, layer2: i32);
  fn JPH_ObjectLayerPairFilterTable_ShouldCollide(filter: ptr, layer1: i32, layer2: i32) -> i32;
  fn JPH_ObjectLayerPairFilterMask_Create() -> ptr;
  fn JPH_ObjectLayerPairFilterMask_GetObjectLayer(group: i32, mask: i32) -> i32;
  fn JPH_ObjectLayerPairFilter_Destroy(filter: ptr);

  # ObjectVsBroadPhaseLayerFilter
  fn JPH_ObjectVsBroadPhaseLayerFilterTable_Create(bp_iface: ptr, num_broad_layers: i32, obj_filter: ptr, num_obj_layers: i32) -> ptr;
  fn JPH_ObjectVsBroadPhaseLayerFilterMask_Create(bp_iface: ptr) -> ptr;
  fn JPH_ObjectVsBroadPhaseLayerFilter_Destroy(filter: ptr);

  # PhysicsSystem
  fn JPH_PhysicsSystem_Create(max_bodies: i32, num_body_mutexes: i32, max_body_pairs: i32, max_contact_constraints: i32, bp_iface: ptr, obj_vs_bp_filter: ptr, obj_filter: ptr) -> ptr;
  fn JPH_PhysicsSystem_Destroy(system: ptr);
  fn JPH_PhysicsSystem_OptimizeBroadPhase(system: ptr);
  fn JPH_PhysicsSystem_Update(system: ptr, delta_time: f32, collision_steps: i32, js: ptr) -> i32;
  fn JPH_PhysicsSystem_GetBodyInterface(system: ptr) -> ptr;
  fn JPH_PhysicsSystem_GetBodyInterfaceNoLock(system: ptr) -> ptr;
  fn JPH_PhysicsSystem_GetBodyLockInterface(system: ptr) -> ptr;
  fn JPH_PhysicsSystem_GetBodyLockInterfaceNoLock(system: ptr) -> ptr;
  fn JPH_PhysicsSystem_GetBroadPhaseQuery(system: ptr) -> ptr;
  fn JPH_PhysicsSystem_GetNarrowPhaseQuery(system: ptr) -> ptr;
  fn JPH_PhysicsSystem_GetNarrowPhaseQueryNoLock(system: ptr) -> ptr;
  fn JPH_PhysicsSystem_SetGravity(system: ptr, x: f32, y: f32, z: f32);
  fn JPH_PhysicsSystem_GetGravity(system: ptr, out_x: ptr, out_y: ptr, out_z: ptr);
  fn JPH_PhysicsSystem_AddConstraint(system: ptr, constraint: ptr);
  fn JPH_PhysicsSystem_RemoveConstraint(system: ptr, constraint: ptr);
  fn JPH_PhysicsSystem_GetNumBodies(system: ptr) -> i32;
  fn JPH_PhysicsSystem_GetNumActiveBodies(system: ptr, body_type: i32) -> i32;
  fn JPH_PhysicsSystem_GetMaxBodies(system: ptr) -> i32;
  fn JPH_PhysicsSystem_GetNumConstraints(system: ptr) -> i32;
  fn JPH_PhysicsSystem_WereBodiesInContact(system: ptr, body1: i32, body2: i32) -> i32;
  fn JPH_PhysicsSystem_SetContactListener(system: ptr, listener: ptr);
  fn JPH_PhysicsSystem_SetBodyActivationListener(system: ptr, listener: ptr);
  fn JPH_PhysicsSystem_AddStepListener(system: ptr, listener: ptr);
  fn JPH_PhysicsSystem_RemoveStepListener(system: ptr, listener: ptr);
  fn JPH_PhysicsSystem_GetPhysicsSettings(system: ptr, result: ptr);
  fn JPH_PhysicsSystem_SetPhysicsSettings(system: ptr, settings: ptr);

  # BodyInterface — CRUD
  fn JPH_BodyInterface_CreateBody(body_iface: ptr, settings: ptr) -> i32;
  fn JPH_BodyInterface_CreateAndAddBody(body_iface: ptr, settings: ptr, activate: i32) -> i32;
  fn JPH_BodyInterface_AddBody(body_iface: ptr, body_id: i32, activate: i32);
  fn JPH_BodyInterface_RemoveBody(body_iface: ptr, body_id: i32);
  fn JPH_BodyInterface_DestroyBody(body_iface: ptr, body_id: i32);
  fn JPH_BodyInterface_IsAdded(body_iface: ptr, body_id: i32) -> i32;

  # BodyInterface — activation
  fn JPH_BodyInterface_ActivateBody(body_iface: ptr, body_id: i32);
  fn JPH_BodyInterface_DeactivateBody(body_iface: ptr, body_id: i32);
  fn JPH_BodyInterface_IsActive(body_iface: ptr, body_id: i32) -> i32;
  fn JPH_BodyInterface_ResetSleepTimer(body_iface: ptr, body_id: i32);

  # BodyInterface — position/rotation/velocity
  fn JPH_BodyInterface_GetPosition(body_iface: ptr, body_id: i32, out_x: ptr, out_y: ptr, out_z: ptr);
  fn JPH_BodyInterface_GetCenterOfMassPosition(body_iface: ptr, body_id: i32, out_x: ptr, out_y: ptr, out_z: ptr);
  fn JPH_BodyInterface_GetRotation(body_iface: ptr, body_id: i32, out_x: ptr, out_y: ptr, out_z: ptr, out_w: ptr);
  fn JPH_BodyInterface_GetWorldTransform(body_iface: ptr, body_id: i32, out: ptr);
  fn JPH_BodyInterface_GetCenterOfMassTransform(body_iface: ptr, body_id: i32, out: ptr);
  fn JPH_BodyInterface_SetPosition(body_iface: ptr, body_id: i32, px: f32, py: f32, pz: f32, activate: i32);
  fn JPH_BodyInterface_SetRotation(body_iface: ptr, body_id: i32, qx: f32, qy: f32, qz: f32, qw: f32, activate: i32);
  fn JPH_BodyInterface_SetPositionAndRotation(body_iface: ptr, body_id: i32, px: f32, py: f32, pz: f32, qx: f32, qy: f32, qz: f32, qw: f32, activate: i32);
  fn JPH_BodyInterface_GetLinearVelocity(body_iface: ptr, body_id: i32, out_x: ptr, out_y: ptr, out_z: ptr);
  fn JPH_BodyInterface_GetAngularVelocity(body_iface: ptr, body_id: i32, out_x: ptr, out_y: ptr, out_z: ptr);
  fn JPH_BodyInterface_SetLinearVelocity(body_iface: ptr, body_id: i32, vx: f32, vy: f32, vz: f32);
  fn JPH_BodyInterface_SetAngularVelocity(body_iface: ptr, body_id: i32, avx: f32, avy: f32, avz: f32);
  fn JPH_BodyInterface_SetLinearAndAngularVelocity(body_iface: ptr, body_id: i32, vx: f32, vy: f32, vz: f32, avx: f32, avy: f32, avz: f32);
  fn JPH_BodyInterface_AddLinearVelocity(body_iface: ptr, body_id: i32, vx: f32, vy: f32, vz: f32);
  fn JPH_BodyInterface_AddLinearAndAngularVelocity(body_iface: ptr, body_id: i32, vx: f32, vy: f32, vz: f32, avx: f32, avy: f32, avz: f32);
  fn JPH_BodyInterface_GetPointVelocity(body_iface: ptr, body_id: i32, px: f32, py: f32, pz: f32, out_x: ptr, out_y: ptr, out_z: ptr);
  fn JPH_BodyInterface_SetPositionRotationAndVelocity(body_iface: ptr, body_id: i32, px: f32, py: f32, pz: f32, qx: f32, qy: f32, qz: f32, qw: f32, vx: f32, vy: f32, vz: f32, avx: f32, avy: f32, avz: f32);
  fn JPH_BodyInterface_MoveKinematic(body_iface: ptr, body_id: i32, tx: f32, ty: f32, tz: f32, tqx: f32, tqy: f32, tqz: f32, tqw: f32, dt: f32);

  # BodyInterface — forces/impulses
  fn JPH_BodyInterface_AddForce(body_iface: ptr, body_id: i32, fx: f32, fy: f32, fz: f32);
  fn JPH_BodyInterface_AddForceAtPoint(body_iface: ptr, body_id: i32, fx: f32, fy: f32, fz: f32, px: f32, py: f32, pz: f32);
  fn JPH_BodyInterface_AddTorque(body_iface: ptr, body_id: i32, tx: f32, ty: f32, tz: f32);
  fn JPH_BodyInterface_AddForceAndTorque(body_iface: ptr, body_id: i32, fx: f32, fy: f32, fz: f32, tx: f32, ty: f32, tz: f32);
  fn JPH_BodyInterface_AddImpulse(body_iface: ptr, body_id: i32, ix: f32, iy: f32, iz: f32);
  fn JPH_BodyInterface_AddImpulseAtPoint(body_iface: ptr, body_id: i32, ix: f32, iy: f32, iz: f32, px: f32, py: f32, pz: f32);
  fn JPH_BodyInterface_AddAngularImpulse(body_iface: ptr, body_id: i32, ix: f32, iy: f32, iz: f32);
  fn JPH_BodyInterface_ApplyBuoyancyImpulse(body_iface: ptr, body_id: i32, sx: f32, sy: f32, sz: f32, snx: f32, sny: f32, snz: f32, buoyancy: f32, lin_drag: f32, ang_drag: f32, fvx: f32, fvy: f32, fvz: f32, grav: f32, dt: f32) -> i32;

  # BodyInterface — material/properties
  fn JPH_BodyInterface_GetFriction(body_iface: ptr, body_id: i32) -> f32;
  fn JPH_BodyInterface_SetFriction(body_iface: ptr, body_id: i32, value: f32);
  fn JPH_BodyInterface_GetRestitution(body_iface: ptr, body_id: i32) -> f32;
  fn JPH_BodyInterface_SetRestitution(body_iface: ptr, body_id: i32, value: f32);
  fn JPH_BodyInterface_GetGravityFactor(body_iface: ptr, body_id: i32) -> f32;
  fn JPH_BodyInterface_SetGravityFactor(body_iface: ptr, body_id: i32, value: f32);
  fn JPH_BodyInterface_GetMaxLinearVelocity(body_iface: ptr, body_id: i32) -> f32;
  fn JPH_BodyInterface_SetMaxLinearVelocity(body_iface: ptr, body_id: i32, value: f32);
  fn JPH_BodyInterface_GetMaxAngularVelocity(body_iface: ptr, body_id: i32) -> f32;
  fn JPH_BodyInterface_SetMaxAngularVelocity(body_iface: ptr, body_id: i32, value: f32);
  fn JPH_BodyInterface_GetUseManifoldReduction(body_iface: ptr, body_id: i32) -> i32;
  fn JPH_BodyInterface_SetUseManifoldReduction(body_iface: ptr, body_id: i32, value: i32);
  fn JPH_BodyInterface_IsSensor(body_iface: ptr, body_id: i32) -> i32;
  fn JPH_BodyInterface_SetIsSensor(body_iface: ptr, body_id: i32, value: i32);
  fn JPH_BodyInterface_GetUserData(body_iface: ptr, body_id: i32) -> i32;
  fn JPH_BodyInterface_SetUserData(body_iface: ptr, body_id: i32, value: i32);
  fn JPH_BodyInterface_InvalidateContactCache(body_iface: ptr, body_id: i32);

  # BodyInterface — shape/layer/type
  fn JPH_BodyInterface_GetShape(body_iface: ptr, body_id: i32) -> ptr;
  fn JPH_BodyInterface_SetShape(body_iface: ptr, body_id: i32, shape: ptr, update_mass: i32, activate: i32);
  fn JPH_BodyInterface_NotifyShapeChanged(body_iface: ptr, body_id: i32, prev_com_x: f32, prev_com_y: f32, prev_com_z: f32, update_mass: i32, activate: i32);
  fn JPH_BodyInterface_GetObjectLayer(body_iface: ptr, body_id: i32) -> i32;
  fn JPH_BodyInterface_SetObjectLayer(body_iface: ptr, body_id: i32, layer: i32);
  fn JPH_BodyInterface_GetMotionType(body_iface: ptr, body_id: i32) -> i32;
  fn JPH_BodyInterface_SetMotionType(body_iface: ptr, body_id: i32, motion_type: i32, activate: i32);
  fn JPH_BodyInterface_GetMotionQuality(body_iface: ptr, body_id: i32) -> i32;
  fn JPH_BodyInterface_SetMotionQuality(body_iface: ptr, body_id: i32, quality: i32);
  fn JPH_BodyInterface_GetBodyType(body_iface: ptr, body_id: i32) -> i32;
  fn JPH_BodyInterface_GetCollisionGroup(body_iface: ptr, body_id: i32) -> ptr;
  fn JPH_BodyInterface_SetCollisionGroup(body_iface: ptr, body_id: i32, group: ptr);

  # BodyCreationSettings
  fn JPH_BodyCreationSettings_Create() -> ptr;
  fn JPH_BodyCreationSettings_SetShape(settings: ptr, shape: ptr);
  fn JPH_BodyCreationSettings_SetPosition(settings: ptr, px: f32, py: f32, pz: f32);
  fn JPH_BodyCreationSettings_SetRotation(settings: ptr, qx: f32, qy: f32, qz: f32, qw: f32);
  fn JPH_BodyCreationSettings_SetLinearVelocity(settings: ptr, vx: f32, vy: f32, vz: f32);
  fn JPH_BodyCreationSettings_SetAngularVelocity(settings: ptr, avx: f32, avy: f32, avz: f32);
  fn JPH_BodyCreationSettings_SetMotionType(settings: ptr, motion_type: i32);
  fn JPH_BodyCreationSettings_SetObjectLayer(settings: ptr, layer: i32);
  fn JPH_BodyCreationSettings_SetUserData(settings: ptr, user_data: i64);
  fn JPH_BodyCreationSettings_SetFriction(settings: ptr, friction: f32);
  fn JPH_BodyCreationSettings_SetRestitution(settings: ptr, restitution: f32);
  fn JPH_BodyCreationSettings_SetLinearDamping(settings: ptr, damping: f32);
  fn JPH_BodyCreationSettings_SetAngularDamping(settings: ptr, damping: f32);
  fn JPH_BodyCreationSettings_SetGravityFactor(settings: ptr, factor: f32);
