  fn JPH_BodyCreationSettings_SetMaxAngularVelocity(settings: ptr, velocity: f32);
  fn JPH_BodyCreationSettings_SetAllowedDOFs(settings: ptr, dofs: i32);
  fn JPH_BodyCreationSettings_SetMotionQuality(settings: ptr, quality: i32);
  fn JPH_BodyCreationSettings_SetIsSensor(settings: ptr, sensor: i32);
  fn JPH_BodyCreationSettings_SetCollideKinematicVsNonDynamic(settings: ptr, value: i32);
  fn JPH_BodyCreationSettings_SetUseManifoldReduction(settings: ptr, value: i32);
  fn JPH_BodyCreationSettings_SetApplyGyroscopicForce(settings: ptr, value: i32);
  fn JPH_BodyCreationSettings_SetEnhancedInternalEdgeRemoval(settings: ptr, value: i32);
  fn JPH_BodyCreationSettings_SetAllowSleeping(settings: ptr, value: i32);
  fn JPH_BodyCreationSettings_SetOverrideMassProperties(settings: ptr, mode: i32);
  fn JPH_BodyCreationSettings_SetMassPropertiesOverride(settings: ptr, mass: f32, i00: f32, i01: f32, i02: f32, i10: f32, i11: f32, i12: f32, i20: f32, i21: f32, i22: f32);
  fn JPH_BodyCreationSettings_SetInertiaMultiplier(settings: ptr, multiplier: f32);
