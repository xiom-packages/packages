module protobuf_tests
use axiom.test;
use axiom.protobuf;

fn test_version() -> TestResult {
  let v = version();
  return assert(v.len() > 0, "protobuf: version string non-empty");
}

fn test_encode_decode_empty() -> TestResult {
  let msg = ProtoMessage{ fields: Map[Int, ProtoValue].new() };
  match encode(&msg) {
    Ok(data) => {
      match decode(&data) {
        Ok(_) => return assert(true, "protobuf: empty roundtrip"),
        Err(e) => return assert(false, "protobuf: decode failed: " + e),
      }
    }
    Err(e) => return assert(false, "protobuf: encode failed: " + e),
  }
}

fn test_varint_value() -> TestResult {
  let msg = ProtoMessage{ fields: Map[Int, ProtoValue].new() };
  msg.fields.insert(1, ProtoValue.Varint(42));
  match encode(&msg) {
    Ok(_) => return assert(true, "protobuf: varint encode"),
    Err(e) => return assert(false, "protobuf: varint failed: " + e),
  }
}

fn main() -> Int {
  var tests = [test_version, test_encode_decode_empty, test_varint_value];
  return test.run_all(tests);
}
