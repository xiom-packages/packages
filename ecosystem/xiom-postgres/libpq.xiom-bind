# PostgreSQL libpq FFI Bindings
# Target: libpq.dll (Windows), libpq.so (Linux), libpq.dylib (macOS)

library "libpq" {
  fn PQconnectdb(conninfo: str) -> ptr;
  fn PQfinish(conn: ptr);
  fn PQstatus(conn: ptr) -> i32;
  fn PQerrorMessage(conn: ptr) -> str;
  fn PQdb(conn: ptr) -> str;
  fn PQuser(conn: ptr) -> str;
  fn PQpass(conn: ptr) -> str;
  fn PQhost(conn: ptr) -> str;
  fn PQport(conn: ptr) -> str;
  fn PQexec(conn: ptr, query: str) -> ptr;
  fn PQexecParams(conn: ptr, command: str, nParams: i32, paramTypes: ptr, paramValues: ptr, paramLengths: ptr, paramFormats: ptr, resultFormat: i32) -> ptr;
  fn PQresultStatus(res: ptr) -> i32;
  fn PQresultErrorMessage(res: ptr) -> str;
  fn PQntuples(res: ptr) -> i32;
  fn PQnfields(res: ptr) -> i32;
  fn PQfname(res: ptr, column_number: i32) -> str;
  fn PQftype(res: ptr, column_number: i32) -> i32;
  fn PQgetvalue(res: ptr, row_number: i32, column_number: i32) -> str;
  fn PQgetisnull(res: ptr, row_number: i32, column_number: i32) -> i32;
  fn PQclear(res: ptr);
  fn PQescapeLiteral(conn: ptr, str: ptr, len: u64) -> str;
  fn PQescapeIdentifier(conn: ptr, str: ptr, len: u64) -> str;
}
