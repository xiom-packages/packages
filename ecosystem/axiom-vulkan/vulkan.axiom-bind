# Vulkan API FFI Bindings — Core 1.3 Functions
# Target: vulkan-1.dll (Windows), libvulkan.so (Linux), libvulkan.dylib (macOS)

library "vulkan-1" {
  # Instance
  fn vkCreateInstance(create_info: ptr, allocator: ptr, instance: ptr) -> i32;
  fn vkDestroyInstance(instance: ptr, allocator: ptr);

  # Physical Devices
  fn vkEnumeratePhysicalDevices(instance: ptr, count: ptr, devices: ptr) -> i32;
  fn vkGetPhysicalDeviceProperties(device: ptr, props: ptr);
  fn vkGetPhysicalDeviceFeatures(device: ptr, features: ptr);
  fn vkGetPhysicalDeviceMemoryProperties(device: ptr, props: ptr);

  # Device
  fn vkCreateDevice(physical_device: ptr, create_info: ptr, allocator: ptr, device: ptr) -> i32;
  fn vkDestroyDevice(device: ptr, allocator: ptr);
  fn vkGetDeviceQueue(device: ptr, queue_family: i32, queue_index: i32, queue: ptr);
  fn vkDeviceWaitIdle(device: ptr) -> i32;

  # Queues
  fn vkQueueSubmit(queue: ptr, submit_count: i32, submits: ptr, fence: ptr) -> i32;
  fn vkQueueWaitIdle(queue: ptr) -> i32;

  # Swapchain (KHR extension)
  fn vkCreateSwapchainKHR(device: ptr, create_info: ptr, allocator: ptr, swapchain: ptr) -> i32;
  fn vkDestroySwapchainKHR(device: ptr, swapchain: ptr, allocator: ptr);
  fn vkGetSwapchainImagesKHR(device: ptr, swapchain: ptr, count: ptr, images: ptr) -> i32;
  fn vkAcquireNextImageKHR(device: ptr, swapchain: ptr, timeout: u64, semaphore: ptr, fence: ptr, image_index: ptr) -> i32;
  fn vkQueuePresentKHR(queue: ptr, present_info: ptr) -> i32;

  # Image Views
  fn vkCreateImageView(device: ptr, create_info: ptr, allocator: ptr, view: ptr) -> i32;
  fn vkDestroyImageView(device: ptr, view: ptr, allocator: ptr);

  # Render Pass
  fn vkCreateRenderPass(device: ptr, create_info: ptr, allocator: ptr, render_pass: ptr) -> i32;
  fn vkDestroyRenderPass(device: ptr, render_pass: ptr, allocator: ptr);

  # Pipeline
  fn vkCreateGraphicsPipelines(device: ptr, cache: ptr, count: i32, create_infos: ptr, allocator: ptr, pipelines: ptr) -> i32;
  fn vkDestroyPipeline(device: ptr, pipeline: ptr, allocator: ptr);

  # Framebuffer
  fn vkCreateFramebuffer(device: ptr, create_info: ptr, allocator: ptr, framebuffer: ptr) -> i32;
  fn vkDestroyFramebuffer(device: ptr, framebuffer: ptr, allocator: ptr);

  # Command Buffers
  fn vkAllocateCommandBuffers(device: ptr, allocate_info: ptr, command_buffers: ptr) -> i32;
  fn vkFreeCommandBuffers(device: ptr, pool: ptr, count: i32, command_buffers: ptr);
  fn vkBeginCommandBuffer(command_buffer: ptr, begin_info: ptr) -> i32;
  fn vkEndCommandBuffer(command_buffer: ptr) -> i32;
  fn vkCmdBeginRenderPass(command_buffer: ptr, render_pass_begin: ptr, contents: i32);
  fn vkCmdEndRenderPass(command_buffer: ptr);
  fn vkCmdBindPipeline(command_buffer: ptr, pipeline_bind_point: i32, pipeline: ptr);
  fn vkCmdDraw(command_buffer: ptr, vertex_count: i32, instance_count: i32, first_vertex: i32, first_instance: i32);

  # Synchronization
  fn vkCreateSemaphore(device: ptr, create_info: ptr, allocator: ptr, semaphore: ptr) -> i32;
  fn vkDestroySemaphore(device: ptr, semaphore: ptr, allocator: ptr);
  fn vkCreateFence(device: ptr, create_info: ptr, allocator: ptr, fence: ptr) -> i32;
  fn vkDestroyFence(device: ptr, fence: ptr, allocator: ptr);
  fn vkWaitForFences(device: ptr, fence_count: i32, fences: ptr, wait_all: i32, timeout: u64) -> i32;

  # Memory
  fn vkAllocateMemory(device: ptr, allocate_info: ptr, allocator: ptr, memory: ptr) -> i32;
  fn vkFreeMemory(device: ptr, memory: ptr, allocator: ptr);
  fn vkMapMemory(device: ptr, memory: ptr, offset: u64, size: u64, flags: i32, data: ptr) -> i32;
  fn vkUnmapMemory(device: ptr, memory: ptr);

  # Buffer
  fn vkCreateBuffer(device: ptr, create_info: ptr, allocator: ptr, buffer: ptr) -> i32;
  fn vkDestroyBuffer(device: ptr, buffer: ptr, allocator: ptr);
  fn vkBindBufferMemory(device: ptr, buffer: ptr, memory: ptr, offset: u64) -> i32;

  # Image
  fn vkCreateImage(device: ptr, create_info: ptr, allocator: ptr, image: ptr) -> i32;
  fn vkDestroyImage(device: ptr, image: ptr, allocator: ptr);
  fn vkBindImageMemory(device: ptr, image: ptr, memory: ptr, offset: u64) -> i32;

  # Shader
  fn vkCreateShaderModule(device: ptr, create_info: ptr, allocator: ptr, shader_module: ptr) -> i32;
  fn vkDestroyShaderModule(device: ptr, shader_module: ptr, allocator: ptr);
}
