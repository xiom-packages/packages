module glfw_tests
use axiom.test;
use axiom.glfw;

fn test_init_terminate() -> TestResult {
  match init() {
    Ok(_) => { terminate(); return assert(true, "glfw init+terminate"); }
    Err(_) => { return assert(true, "glfw skip (no display)"); }
  }
}

fn main() -> Int {
  var tests = [test_init_terminate];
  return test.run_all(tests);
}
