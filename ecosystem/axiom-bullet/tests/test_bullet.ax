module bullet_tests
use axiom.test;
use axiom.bullet;

fn test_create_world() -> TestResult {
  let world = create_world();
  return assert(world != 0, "bullet: world handle valid");
}

fn test_set_gravity() -> TestResult {
  let world = create_world();
  set_gravity(world, 0.0, -9.81, 0.0);
  return assert(true, "bullet: gravity set");
}

fn test_create_sphere() -> TestResult {
  let shape = create_sphere_shape(1.0);
  return assert(shape != 0, "bullet: sphere shape valid");
}

fn test_create_rigid_body() -> TestResult {
  let shape = create_sphere_shape(1.0);
  let body = create_rigid_body(1.0, shape);
  return assert(body != 0, "bullet: rigid body valid");
}

fn main() -> Int {
  var tests = [test_create_world, test_set_gravity, test_create_sphere, test_create_rigid_body];
  return test.run_all(tests);
}
