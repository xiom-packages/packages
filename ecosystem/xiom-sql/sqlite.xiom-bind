# SQLite3 FFI Bindings

library "libsqlite3" {
  fn sqlite3_open(path: str, db: ptr) -> i32;
  fn sqlite3_close(db: ptr) -> i32;
  fn sqlite3_exec(db: ptr, sql: str, callback: ptr, arg: ptr, err: ptr) -> i32;
  fn sqlite3_prepare_v2(db: ptr, sql: str, len: i32, stmt: ptr, tail: ptr) -> i32;
  fn sqlite3_step(stmt: ptr) -> i32;
  fn sqlite3_column_int(stmt: ptr, col: i32) -> i32;
  fn sqlite3_column_text(stmt: ptr, col: i32) -> str;
  fn sqlite3_finalize(stmt: ptr) -> i32;
  fn sqlite3_errmsg(db: ptr) -> str;
}
