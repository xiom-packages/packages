module grpc_tests
use axiom.test;
use axiom.grpc;

fn test_init_shutdown() -> TestResult {
  init();
  shutdown();
  return assert(true, "grpc: init/shutdown cycle");
}

fn test_create_channel_insecure() -> TestResult {
  init();
  let ch = create_channel("localhost:50051", false);
  let ok = ch != 0;
  destroy_channel(ch);
  shutdown();
  return assert(ok, "grpc: insecure channel created");
}

fn test_unary_call_failure() -> TestResult {
  init();
  let ch = create_channel("localhost:1", false);
  let req = Vec[UInt8].new();
  match unary_call(ch, "/test.Service/Method", &req) {
    Ok(_) => {
      destroy_channel(ch);
      shutdown();
      return assert(false, "grpc: unexpected success");
    }
    Err(_) => {
      destroy_channel(ch);
      shutdown();
      return assert(true, "grpc: connection failure handled");
    }
  }
}

fn main() -> Int {
  var tests = [test_init_shutdown, test_create_channel_insecure, test_unary_call_failure];
  return test.run_all(tests);
}
