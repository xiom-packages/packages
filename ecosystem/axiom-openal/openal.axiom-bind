# OpenAL Soft FFI Bindings — 3D Audio
# Target: OpenAL32.dll (Windows), libopenal.so (Linux), libopenal.dylib (macOS)

library "OpenAL32" {
  fn alGetError() -> i32;
  fn alGetString(param: i32) -> ptr;

  fn alGenSources(n: i32, sources: ptr);
  fn alDeleteSources(n: i32, sources: ptr);
  fn alSourcef(source: i32, param: i32, value: f32);
  fn alSourcei(source: i32, param: i32, value: i32);
  fn alSourcefv(source: i32, param: i32, values: ptr);
  fn alSourcePlay(source: i32);
  fn alSourcePause(source: i32);
  fn alSourceStop(source: i32);
  fn alSourceRewind(source: i32);
  fn alGetSourcei(source: i32, param: i32, value: ptr);

  fn alGenBuffers(n: i32, buffers: ptr);
  fn alDeleteBuffers(n: i32, buffers: ptr);
  fn alBufferData(buffer: i32, format: i32, data: ptr, size: i32, freq: i32);

  fn alListenerf(param: i32, value: f32);
  fn alListenerfv(param: i32, values: ptr);
  fn alListener3f(param: i32, v1: f32, v2: f32, v3: f32);

  fn alDistanceModel(model: i32);
}
